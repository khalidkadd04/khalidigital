---
/**
 * Skills.astro
 * ─────────────────────────────────────────────────────────────────
 * Displays technical skills grouped by discipline.
 * Skill bars animate in when the section enters the viewport
 * (IntersectionObserver in the <script> block below).
 *
 * To add or edit skills: modify the `skillGroups` array below.
 * No component API props — data lives directly in this file.
 */

const skillGroups = [
  {
    id: 'marketing',
    title: 'Digital Marketing',
    accent: 'teal',
    icon: '📣',
    skills: [
      { name: 'SEO / Technical Audit', level: 82 },
      { name: 'Google Ads (Search)',   level: 78 },
      { name: 'Meta Ads Manager',      level: 75 },
      { name: 'Email Marketing',       level: 73 },
      { name: 'Content Strategy',      level: 80 },
    ],
  },
  {
    id: 'bi',
    title: 'Business Intelligence',
    accent: 'indigo',
    icon: '📊',
    skills: [
      { name: 'Power BI',              level: 82 },
      { name: 'Google Data Studio',    level: 86 },
      { name: 'Tableau (fundamentals)',level: 65 },
      { name: 'SQL',                   level: 70 },
      { name: 'Data Modeling',         level: 68 },
    ],
  },
  {
    id: 'analytics',
    title: 'Analytics & Data',
    accent: 'purple',
    icon: '📈',
    skills: [
      { name: 'Google Analytics 4',    level: 90 },
      { name: 'Google Tag Manager',    level: 75 },
      { name: 'Excel / Pivot Tables',  level: 84 },
      { name: 'Python (pandas)',        level: 58 },
      { name: 'A/B Testing',           level: 68 },
    ],
  },
  {
    id: 'tools',
    title: 'Tools & Platforms',
    accent: 'amber',
    icon: '🛠️',
    skills: [
      { name: 'Semrush / Ahrefs',      level: 78 },
      { name: 'HubSpot CRM',           level: 70 },
      { name: 'Canva / Figma',         level: 72 },
      { name: 'Notion / Asana',        level: 80 },
      { name: 'Google Workspace',      level: 90 },
    ],
  },
];

// Map accent name → CSS custom property
const accentVar: Record<string, string> = {
  indigo: 'var(--indigo)',
  teal:   'var(--teal)',
  purple: '#A78BFA',
  amber:  'var(--amber)',
};
---

<section id="skills" class="skills-section" aria-labelledby="skills-heading">

  <div class="section-header">
    <h2 id="skills-heading" class="section-title">Skills</h2>
    <p class="section-sub">Tools and disciplines I've built competence in during my studies and projects.</p>
  </div>

  <div class="skills-grid">
    {skillGroups.map((group) => (
      <div class="skill-card" data-group={group.id}>

        <div class="skill-card-header">
          <span class="skill-icon" aria-hidden="true">{group.icon}</span>
          <h3 class="skill-card-title" style={`color: ${accentVar[group.accent]}`}>
            {group.title}
          </h3>
        </div>

        <ul class="skill-list" aria-label={`${group.title} skills`}>
          {group.skills.map((skill) => (
            <li class="skill-item">
              <div class="skill-row">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-pct" aria-hidden="true">{skill.level}%</span>
              </div>
              <div class="skill-track" role="progressbar"
                   aria-valuenow={skill.level} aria-valuemin={0} aria-valuemax={100}
                   aria-label={`${skill.name}: ${skill.level}%`}>
                <div
                  class="skill-bar"
                  data-width={skill.level}
                  style={`--bar-color: ${accentVar[group.accent]}; width: 0`}
                ></div>
              </div>
            </li>
          ))}
        </ul>

      </div>
    ))}
  </div>

  <!-- Language proficiency — separate treatment -->
  <div class="languages">
    <h3 class="languages-title">Languages</h3>
    <ul class="lang-list">
      <li class="lang-item">
        <span class="lang-name">Arabic</span>
        <span class="lang-level lang-native">Native</span>
      </li>
      <li class="lang-item">
        <span class="lang-name">French</span>
        <span class="lang-level lang-fluent">Fluent (C1)</span>
      </li>
      <li class="lang-item">
        <span class="lang-name">English</span>
        <span class="lang-level lang-proficient">Proficient (B2)</span>
      </li>
      <li class="lang-item">
        <span class="lang-name">Tamazight</span>
        <span class="lang-level lang-native">Native</span>
      </li>
    </ul>
  </div>

</section>

<style>
  .skills-section {
    padding: var(--space-24) var(--space-6);
    border-top: 1px solid var(--ink-border);
  }
  @media (min-width: 1024px) { .skills-section { padding-inline: var(--space-16); } }

  .section-header {
    margin-bottom: var(--space-12);
    max-width: 600px;
  }
  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--sand);
    margin-bottom: var(--space-3);
  }
  .section-sub {
    font-size: var(--text-lg);
    color: var(--sand-dim);
    line-height: 1.6;
  }

  /* 2-col grid on md, 4-col on xl */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px)  { .skills-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1200px) { .skills-grid { grid-template-columns: repeat(4, 1fr); } }

  /* Card */
  .skill-card {
    background: var(--ink-raised);
    border: 1px solid var(--ink-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: border-color var(--t), transform var(--t);
  }
  .skill-card:hover {
    border-color: rgba(91,107,248,0.25);
    transform: translateY(-3px);
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--ink-border);
  }
  .skill-icon {
    font-size: 1.25rem;
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.03);
    border-radius: 8px;
    flex-shrink: 0;
  }
  .skill-card-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  /* Skill rows */
  .skill-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .skill-item { display: flex; flex-direction: column; gap: 6px; }
  .skill-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .skill-name {
    font-size: var(--text-sm);
    color: var(--sand);
    font-weight: 400;
  }
  .skill-pct {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--sand-dim);
    min-width: 2.5ch;
    text-align: right;
  }

  /* Bar track */
  .skill-track {
    height: 3px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: hidden;
  }
  .skill-bar {
    height: 100%;
    border-radius: 2px;
    background: var(--bar-color, var(--indigo));
    transition: width 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Languages block */
  .languages {
    margin-top: var(--space-12);
    padding: var(--space-6);
    background: var(--ink-raised);
    border: 1px solid var(--ink-border);
    border-radius: var(--radius-lg);
    max-width: 480px;
  }
  .languages-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--sand-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .lang-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .lang-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .lang-name {
    font-size: var(--text-sm);
    color: var(--sand);
  }
  .lang-level {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 100px;
  }
  .lang-native    { background: var(--indigo-dim);  color: var(--indigo); }
  .lang-fluent    { background: var(--teal-dim);    color: var(--teal);   }
  .lang-proficient{ background: var(--amber-dim);   color: var(--amber);  }
</style>

<script>
  // Animate skill bars when section enters viewport
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll<HTMLElement>('.skill-bar').forEach((bar) => {
            const target = bar.dataset.width ?? '0';
            bar.style.width = `${target}%`;
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.25 }
  );

  document.querySelectorAll<HTMLElement>('.skill-card').forEach((card) => {
    observer.observe(card);
  });
</script>
