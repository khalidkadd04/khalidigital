---
import profile from '../content/data/profile.json';
import SocialLinks from './SocialLinks.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-brand">
      <div class="footer-logo">
        {profile.firstName} {profile.lastName}<span class="dot">.</span>
      </div>
      <p class="footer-role">{profile.roleBadge}</p>
      <p class="footer-copy">© {currentYear} — Tous droits réservés</p>
    </div>

    <div class="footer-socials">
      <span class="footer-social-label">Réseaux & Contacts</span>
      <SocialLinks className="footer-social-list" />
    </div>

    <div class="footer-admin">
      <a href={`${base}admin/`} class="footer-admin-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        Administration CMS
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    padding: 3rem 2rem 2.5rem;
    background: var(--ink-2, #13131F);
    color: var(--muted, #7B7C99);
    font-size: 0.88rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-container {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      align-items: flex-start;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-logo {
    font-family: var(--font-display, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--off-white, #F2F0EC);
  }

  .dot {
    color: var(--violet, #7C3AED);
  }

  .footer-role {
    font-size: 0.82rem;
    color: var(--muted, #7B7C99);
  }

  .footer-copy {
    font-size: 0.78rem;
    color: rgba(123, 124, 153, 0.75);
    margin-top: 0.25rem;
  }

  .footer-socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .footer-socials {
      align-items: flex-start;
    }
  }

  .footer-social-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--off-white, #F2F0EC);
  }

  .footer-admin {
    display: flex;
    align-items: center;
  }

  .footer-admin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted, #7B7C99);
    text-decoration: none;
    font-size: 0.8rem;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .footer-admin-link:hover {
    color: var(--off-white, #F2F0EC);
    border-color: var(--violet, #7C3AED);
    background: rgba(124, 58, 237, 0.1);
  }
</style>
