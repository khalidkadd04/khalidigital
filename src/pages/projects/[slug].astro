---
import { getCollection, render } from 'astro:content';
import ProjectPage from '../../layouts/ProjectPage.astro';
import { sortProjects, filterVisibleProjects } from '../../utils/projects';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const visible = filterVisibleProjects(allProjects);
  const sorted = sortProjects(visible);

  return sorted.map((project, index) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
      prevProject: index > 0 ? { slug: sorted[index - 1].id, title: sorted[index - 1].data.title } : null,
      nextProject: index < sorted.length - 1 ? { slug: sorted[index + 1].id, title: sorted[index + 1].data.title } : null,
    },
  }));
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
---

<ProjectPage
  title={project.data.title}
  description={project.data.description}
  category={project.data.category}
  date={new Date(project.data.date)}
  tags={project.data.tags}
  metrics={project.data.metrics}
  image={project.data.image}
  gallery={project.data.gallery}
  link={project.data.link}
  status={project.data.status}
  prevProject={prevProject}
  nextProject={nextProject}
>
  <Content />
</ProjectPage>