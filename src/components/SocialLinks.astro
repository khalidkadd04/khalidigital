---
import profile from '../content/data/profile.json';

interface Props {
  className?: string;
  showLabels?: boolean;
}

const { className = '', showLabels = false } = Astro.props;

interface SocialItem {
  name: string;
  url: string;
  icon: string;
}

let items: SocialItem[] = [];

if (Array.isArray(profile.socialLinks) && profile.socialLinks.length > 0) {
  items = profile.socialLinks.filter((item) => item && item.url && item.url.trim());
} else if (profile.contact) {
  // Rétrocompatibilité avec l'ancien format
  if (profile.contact.linkedin) {
    items.push({ name: 'LinkedIn', url: profile.contact.linkedin, icon: 'linkedin' });
  }
  if (profile.contact.github) {
    items.push({ name: 'GitHub', url: profile.contact.github, icon: 'github' });
  }
  if (profile.contact.behance) {
    items.push({ name: 'Behance', url: profile.contact.behance, icon: 'behance' });
  }
  if (profile.contact.twitter) {
    items.push({ name: 'Twitter / X', url: profile.contact.twitter, icon: 'twitter' });
  }
}
---

<div class={`social-links-wrap ${className}`}>
  {items.map((item) => {
    const iconType = (item.icon || 'link').toLowerCase().trim();
    return (
      <a
        href={item.url}
        class="social-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={item.name}
        title={item.name}
      >
        <span class="social-icon" aria-hidden="true">
          {iconType === 'linkedin' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          )}
          {iconType === 'github' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
            </svg>
          )}
          {iconType === 'twitter' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4l16 16M4 20L20 4"/>
            </svg>
          )}
          {iconType === 'behance' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 7h5.5a2.5 2.5 0 0 1 0 5H2V7zm0 5h6a2.5 2.5 0 0 1 0 5H2v-5zm11-1a3.5 3.5 0 0 1 7 0v1h-7a3.5 3.5 0 0 0 6.5 1M14 6h5"/>
            </svg>
          )}
          {iconType === 'instagram' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          )}
          {iconType === 'whatsapp' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          )}
          {iconType === 'youtube' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
            </svg>
          )}
          {iconType === 'email' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          )}
          {iconType === 'phone' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          )}
          {iconType !== 'linkedin' &&
            iconType !== 'github' &&
            iconType !== 'twitter' &&
            iconType !== 'behance' &&
            iconType !== 'instagram' &&
            iconType !== 'whatsapp' &&
            iconType !== 'youtube' &&
            iconType !== 'email' &&
            iconType !== 'phone' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            )}
        </span>
        {showLabels && <span class="social-label">{item.name}</span>}
      </a>
    );
  })}
</div>

<style>
  .social-links-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .social-btn {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--card-bg, #16162A);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted, #7B7C99);
    transition: border-color var(--t, 0.35s), color var(--t, 0.35s), transform var(--t, 0.35s), background var(--t, 0.35s);
    text-decoration: none;
    touch-action: manipulation;
  }
  .social-btn:hover {
    border-color: var(--violet, #7C3AED);
    color: var(--violet-l, #A78BFA);
    transform: translateY(-3px);
    background: rgba(124, 58, 237, 0.08);
  }
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .social-label {
    font-size: 0.85rem;
    font-weight: 500;
    margin-left: 0.4rem;
    color: var(--off-white, #F2F0EC);
  }
</style>
