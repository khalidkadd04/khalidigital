---
import { getCollection } from 'astro:content';
import profile from '../content/data/profile.json';
import skillsData from '../content/data/skills.json';
import certsData from '../content/data/certifications.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Favicon from '../components/Favicon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Fonts from '../components/Fonts.astro';
import { sortProjects, filterProjectsForHome, resolveMediaUrl } from '../utils/projects';

const rawProjects = await getCollection('projects');
const homeProjects = filterProjectsForHome(rawProjects);
const projects = sortProjects(homeProjects);

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const initials = `${profile.firstName?.[0] || 'V'}${profile.lastName?.[0] || 'N'}`;

const getCategoryIcon = (category: string) => {
  switch (category) {
    case 'bi': return '📊';
    case 'marketing': return '🎯';
    case 'analytics': return '🔍';
    case 'strategy': return '📱';
    default: return '📊';
  }
};

const getLinkText = (category: string) => {
  switch (category) {
    case 'bi': return 'Voir le rapport';
    case 'marketing': return "Voir l'étude";
    case 'analytics': return "Voir l'audit";
    case 'strategy': return 'Voir la stratégie';
    default: return 'Voir le projet';
  }
};

const getStatusBadge = (s?: string) => {
  if (!s || !s.trim()) return null;
  const lower = s.toLowerCase().trim();
  if (lower.includes('termin') || lower.includes('fini') || lower.includes('complét')) {
    return { cls: 'status-done', dotCls: 'dot-done', text: s };
  }
  if (lower.includes('cours') || lower.includes('progr') || lower.includes('développ')) {
    return { cls: 'status-progress', dotCls: 'dot-progress', text: s };
  }
  if (lower.includes('test') || lower.includes('révis')) {
    return { cls: 'status-test', dotCls: 'dot-test', text: s };
  }
  return { cls: 'status-default', dotCls: 'dot-default', text: s };
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <!-- Google Tag Manager (Chargement intelligent sur interaction ou après rendu) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function initGTM() {
      if (window._gtmLoaded) return;
