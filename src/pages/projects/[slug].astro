---
import { getCollection, render } from 'astro:content';
import ProjectPage from '../../layouts/ProjectPage.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  // Tri identique à la page d'accueil : mis en avant d'abord, puis date décroissante
  const sorted = [...projects].sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

  return sorted.map((project, index) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
      prevProject: index > 0 ? { slug: sorted[index - 1].id, title: sorted[index - 1].data.title } : null,
      nextProject: index < sorted.length - 1 ? { slug: sorted[index + 1].id, title: sorted[index + 1].data.title } : null,
    },
  }));
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
---

<ProjectPage
  title={project.data.title}
  description={project.data.description}
  category={project.data.category}
  date={new Date(project.data.date)}
  tags={project.data.tags}
  metrics={project.data.metrics}
  image={project.data.image}
  link={project.data.link}
  status={project.data.status}
  prevProject={prevProject}
  nextProject={nextProject}
>
  <Content />
</ProjectPage>