---
/**
 * Fonts.astro
 * Auto-hébergement haute performance des polices Plus Jakarta Sans et DM Sans.
 * Élimine 100% des requêtes réseau externes vers Google Fonts pour un FCP / LCP instantané.
 */
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const fontStyle = `
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url('${base}fonts/PlusJakartaSans-Latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'DM Sans';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('${base}fonts/DMSans-Latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
`;
---
<link rel="preload" href={`${base}fonts/PlusJakartaSans-Latin.woff2`} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={`${base}fonts/DMSans-Latin.woff2`} as="font" type="font/woff2" crossorigin />
<style set:html={fontStyle} />
