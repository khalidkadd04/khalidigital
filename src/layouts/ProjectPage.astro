---
/**
 * ProjectPage.astro
 * ─────────────────────────────────────────────────────────────────
 * Layout harmonisé pour les pages de détail de projet.
 * Respecte à 100% le système de design, les polices, les couleurs,
 * la barre de navigation et le pied de page de la page principale.
 */

import profile from '../content/data/profile.json';

interface Metric {
  value: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  tags: string[];
  category: 'bi' | 'marketing' | 'analytics' | 'strategy';
  date: Date;
  status?: string;
  link?: string;
  metrics?: Metric[];
  image?: string;
  prevProject?: { slug: string; title: string } | null;
  nextProject?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  tags = [],
  category = 'bi',
  date,
  status,
  link,
  metrics = [],
  image,
  prevProject,
  nextProject,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const initials = `${profile.firstName?.[0] || 'K'}${profile.lastName?.[0] || 'K'}`;

const categoryMeta: Record<string, { label: string; tagClass: string; icon: string }> = {
  bi:        { label: 'Business Intelligence', tagClass: '',  icon: '📊' },
  marketing: { label: 'Marketing Digital',     tagClass: 't', icon: '🎯' },
  analytics: { label: 'Analytics & Data',      tagClass: 'a', icon: '🔍' },
  strategy:  { label: 'Stratégie Digitale',    tagClass: '',  icon: '📱' },
};
const catInfo = categoryMeta[category] ?? { label: category, tagClass: '', icon: '📊' };

const getStatusBadge = (s?: string) => {
  if (!s || !s.trim()) return null;
  const lower = s.toLowerCase().trim();
  if (lower.includes('termin') || lower.includes('fini') || lower.includes('complét')) {
    return { cls: 'status-done', dotCls: 'dot-done', text: s };
  }
  if (lower.includes('cours') || lower.includes('progr') || lower.includes('développ')) {
    return { cls: 'status-progress', dotCls: 'dot-progress', text: s };
  }
  if (lower.includes('test') || lower.includes('révis')) {
    return { cls: 'status-test', dotCls: 'dot-test', text: s };
  }
  return { cls: 'status-default', dotCls: 'dot-default', text: s };
};
const statusBadge = getStatusBadge(status);

const formattedDate = date ? new Date(date).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}) : '';

const resolveMediaUrl = (url?: string) => {
  if (!url) return '';
  if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('data:')) {
    return url;
  }
  const cleanPath = url.replace(/^\/+/, '');
  const encodedPath = cleanPath.split('/').map((segment) => encodeURIComponent(decodeURIComponent(segment))).join('/');
  return `${base}${encodedPath}`;
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-PG83BFNF');</script>
  <!-- End Google Tag Manager -->

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — {profile.firstName} {profile.lastName}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} — ${profile.firstName} ${profile.lastName}`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

  <style>
    /* ═══════════════════════════════════════════════════
       TOKENS HARMONISÉS AVEC LA PAGE PRINCIPALE
    ═══════════════════════════════════════════════════ */
    :root {
      --ink:       #0D0D14;
      --ink-2:     #13131F;
      --surface:   #1A1A2E;
      --off-white: #F2F0EC;
      --violet:    #7C3AED;
      --violet-l:  #A78BFA;
      --teal:      #0EA5A0;
      --amber:     #F59E0B;
      --muted:     #7B7C99;
      --border:    rgba(255,255,255,0.07);
      --card-bg:   #16162A;

      --font-display: 'Plus Jakarta Sans', sans-serif;
      --font-body:    'DM Sans', sans-serif;
      --ease:      cubic-bezier(0.4, 0, 0.2, 1);
      --t:         0.35s var(--ease);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--ink);
      color: var(--off-white);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* Curseur interactif desktop */
    @media (pointer: fine) {
      body { cursor: none; }
      #cursor-dot, #cursor-ring {
        position: fixed; pointer-events: none;
        z-index: 9999; border-radius: 50%;
        transform: translate(-50%, -50%);
      }
      #cursor-dot { width: 5px; height: 5px; background: var(--violet); }
      #cursor-ring {
        width: 30px; height: 30px;
        border: 1.5px solid var(--violet);
        opacity: 0.45;
        transition: width .2s, height .2s, border-color .2s, opacity .2s;
      }
    }

    /* ═══════════════════════════════════════════════════
       NAVBAR IDENTIQUE À LA PAGE D'ACCUEIL
    ═══════════════════════════════════════════════════ */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 200;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.1rem 2rem;
      transition: background var(--t), border-color var(--t), padding var(--t);
      border-bottom: 1px solid transparent;
    }
    nav.scrolled {
      background: rgba(13,13,20,0.88);
      backdrop-filter: blur(20px);
      border-bottom-color: var(--border);
      padding-top: 0.75rem; padding-bottom: 0.75rem;
    }
    .nav-logo {
      font-family: var(--font-display);
      font-weight: 800; font-size: 1.05rem;
      letter-spacing: -0.02em;
      display: flex; align-items: center; gap: 0.3rem;
    }
    .nav-logo .dot { color: var(--violet); font-size: 1.4rem; line-height: 1; }

    .nav-links {
      display: flex; align-items: center; gap: 2rem;
    }
    .nav-links a {
      font-family: var(--font-display);
      font-size: 0.82rem; font-weight: 500;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--muted);
      transition: color var(--t);
    }
    .nav-links a:hover { color: var(--off-white); }
    .nav-links .nav-cta {
      background: var(--violet);
      color: #fff;
      padding: 0.5rem 1.25rem;
      border-radius: 6px;
      font-weight: 600;
      transition: background var(--t), transform var(--t);
    }
    .nav-links .nav-cta:hover { background: #6d28d9; transform: translateY(-1px); }

    .nav-hamburger {
      display: none;
      flex-direction: column; gap: 5px;
      width: 28px; cursor: pointer;
      background: none; border: none; padding: 4px;
    }
    .nav-hamburger span {
      display: block; height: 2px; border-radius: 2px;
      background: var(--off-white);
      transition: transform .3s, opacity .3s, width .3s;
      transform-origin: left center;
    }
    .nav-hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(0, -1px); }
    .nav-hamburger.open span:nth-child(2) { opacity: 0; width: 0; }
    .nav-hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(0, 1px); }

    .nav-drawer {
      display: none;
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(13,13,20,0.97);
      backdrop-filter: blur(24px);
      z-index: 190;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 2.5rem;
      opacity: 0;
      transition: opacity .3s;
      pointer-events: none;
    }
    .nav-drawer.open {
      opacity: 1;
      pointer-events: all;
    }
    .nav-drawer a {
      font-family: var(--font-display);
      font-size: 1.5rem; font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--muted);
      transition: color .2s;
    }
    .nav-drawer a:hover, .nav-drawer a:focus { color: var(--off-white); }

    @media (max-width: 767px) {
      .nav-links { display: none; }
      .nav-hamburger { display: flex; }
      .nav-drawer { display: flex; }
    }
    @media (min-width: 768px) { nav { padding: 1.25rem 3rem; } }
    @media (min-width: 1100px) { nav { padding: 1.25rem 5rem; } }

    /* ═══════════════════════════════════════════════════
       AMBIANCE D'ARRIÈRE-PLAN
    ═══════════════════════════════════════════════════ */
    .bg-noise {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      opacity: 0.35;
    }
    .bg-glow-1 {
      position: fixed; top: -150px; left: -100px; z-index: 0; pointer-events: none;
      width: 550px; height: 550px; border-radius: 50%;
      background: radial-gradient(circle, rgba(124,58,237,0.14) 0%, transparent 70%);
      filter: blur(80px);
    }
    .bg-glow-2 {
      position: fixed; top: 30%; right: -150px; z-index: 0; pointer-events: none;
      width: 450px; height: 450px; border-radius: 50%;
      background: radial-gradient(circle, rgba(14,165,160,0.10) 0%, transparent 70%);
      filter: blur(80px);
    }

    /* ═══════════════════════════════════════════════════
       CONTENU DU PROJET
    ═══════════════════════════════════════════════════ */
    main {
      flex: 1;
      position: relative;
      z-index: 1;
      padding: 6.5rem 1.5rem 5rem;
      max-width: 860px;
      margin-inline: auto;
      width: 100%;
    }

    /* Fil d'Ariane & Bouton retour */
    .breadcrumb-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2.25rem;
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--muted);
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      padding: 0.45rem 1rem;
      border-radius: 100px;
      transition: color var(--t), border-color var(--t), background var(--t), transform var(--t);
    }
    .back-btn:hover {
      color: var(--off-white);
      border-color: rgba(124,58,237,0.4);
      background: rgba(124,58,237,0.1);
      transform: translateX(-3px);
    }
    .project-meta-badges {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .meta-badge {
      font-size: 0.72rem;
      font-family: var(--font-display);
      font-weight: 600;
      padding: 0.3rem 0.75rem;
      border-radius: 100px;
      background: rgba(124,58,237,0.12);
      color: var(--violet-l);
      border: 1px solid rgba(124,58,237,0.25);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .meta-badge.t { background: rgba(14,165,160,0.12); color: var(--teal); border-color: rgba(14,165,160,0.25); }
    .meta-badge.a { background: rgba(245,158,11,0.12); color: var(--amber); border-color: rgba(245,158,11,0.25); }
    .meta-badge.status-done {
      background: rgba(34,197,94,0.12);
      color: #4ade80;
      border-color: rgba(34,197,94,0.3);
    }
    .meta-badge.status-progress {
      background: rgba(245,158,11,0.12);
      color: #fbbf24;
      border-color: rgba(245,158,11,0.3);
    }
    .meta-badge.status-test {
      background: rgba(14,165,160,0.12);
      color: var(--teal);
      border-color: rgba(14,165,160,0.3);
    }
    .meta-badge.status-default {
      background: rgba(124,58,237,0.12);
      color: var(--violet-l);
      border-color: rgba(124,58,237,0.3);
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 6px currentColor;
    }
    .dot-progress {
      animation: pulse-dot 2s infinite ease-in-out;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.8); }
    }
    .meta-date {
      font-size: 0.78rem;
      color: var(--muted);
      font-family: var(--font-display);
    }

    /* En-tête du projet */
    .project-hero-header {
      margin-bottom: 2.5rem;
    }
    .project-main-title {
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 4vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.15;
      color: var(--off-white);
      margin-bottom: 1rem;
    }
    .project-main-desc {
      font-size: 1.08rem;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 1.75rem;
    }

    /* Chiffres clés / Métriques */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.75rem;
    }
    .metric-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.2rem 1.4rem;
      transition: border-color var(--t), transform var(--t);
    }
    .metric-card:hover {
      border-color: rgba(124,58,237,0.35);
      transform: translateY(-2px);
    }
    .metric-value {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--violet-l);
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 0.35rem;
    }
    .metric-label {
      font-size: 0.75rem;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    /* Tags et boutons d'action */
    .project-actions-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }
    .project-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .tag {
      font-size: 0.72rem;
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: 0.04em;
      padding: 0.25rem 0.65rem;
      border-radius: 100px;
      background: rgba(124,58,237,0.1);
      color: var(--violet-l);
      border: 1px solid rgba(124,58,237,0.2);
    }
    .tag.t { background: rgba(14,165,160,0.1); color: var(--teal); border-color: rgba(14,165,160,0.2); }
    .tag.a { background: rgba(245,158,11,0.1); color: var(--amber); border-color: rgba(245,158,11,0.2); }

    .external-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--violet);
      color: #fff;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.55rem 1.25rem;
      border-radius: 8px;
      transition: background var(--t), transform var(--t), box-shadow var(--t);
    }
    .external-btn:hover {
      background: #6d28d9;
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(124,58,237,0.35);
    }

    /* Illustration principale */
    .project-hero-thumb {
      margin-top: 2rem;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--card-bg);
      box-shadow: 0 16px 40px rgba(0,0,0,0.35);
    }
    .project-hero-thumb img {
      width: 100%;
      max-height: 480px;
      object-fit: cover;
    }

    /* ═══════════════════════════════════════════════════
       CORPS DE L'ÉTUDE DE CAS (PROSE MARKDOWN)
    ═══════════════════════════════════════════════════ */
    .project-prose {
      margin-top: 2.75rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--border);
    }
    .project-prose :global(h2) {
      font-family: var(--font-display);
      font-size: 1.55rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--off-white);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .project-prose :global(h2:first-child) { margin-top: 0; }
    .project-prose :global(h3) {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--off-white);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
    .project-prose :global(p) {
      font-size: 1.02rem;
      line-height: 1.8;
      color: rgba(242, 240, 236, 0.88);
      margin-bottom: 1.35rem;
    }
    .project-prose :global(ul), .project-prose :global(ol) {
      padding-left: 1.5rem;
      margin-bottom: 1.5rem;
    }
    .project-prose :global(li) {
      font-size: 1.02rem;
      line-height: 1.75;
      color: rgba(242, 240, 236, 0.88);
      margin-bottom: 0.5rem;
    }
    .project-prose :global(li strong) {
      color: var(--off-white);
    }
    .project-prose :global(code) {
      background: rgba(124,58,237,0.12);
      color: var(--violet-l);
      padding: 0.2rem 0.45rem;
      border-radius: 4px;
      font-size: 0.88em;
      border: 1px solid rgba(124,58,237,0.22);
      font-family: 'JetBrains Mono', monospace, ui-monospace;
    }
    .project-prose :global(pre) {
      background: #10101c !important;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      overflow-x: auto;
      margin: 1.75rem 0;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }
    .project-prose :global(pre code) {
      background: transparent !important;
      padding: 0;
      border: none;
      color: inherit;
      font-size: 0.9em;
    }
    .project-prose :global(blockquote) {
      border-left: 3px solid var(--violet);
      background: rgba(124,58,237,0.06);
      border-radius: 0 8px 8px 0;
      padding: 1rem 1.4rem;
      margin: 1.75rem 0;
      font-style: italic;
      color: var(--off-white);
    }
    .project-prose :global(a) {
      color: var(--violet-l);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color var(--t);
    }
    .project-prose :global(a:hover) {
      color: var(--teal);
    }

    /* ═══════════════════════════════════════════════════
       NAVIGATION PROJET PRÉCÉDENT / SUIVANT
    ═══════════════════════════════════════════════════ */
    .project-nav-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      position: relative;
      clear: both;
      z-index: 1;
    }
    @media (min-width: 640px) {
      .project-nav-row { grid-template-columns: 1fr 1fr; }
    }
    .proj-nav-spacer {
      display: none;
    }
    @media (min-width: 640px) {
      .proj-nav-spacer {
        display: block;
      }
    }
    .proj-nav-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      transition: border-color var(--t), transform var(--t), box-shadow var(--t);
      position: relative;
    }
    .proj-nav-card:hover {
      border-color: rgba(124,58,237,0.4);
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .proj-nav-prev:hover {
      transform: translateX(-4px);
    }
    .proj-nav-next:hover {
      transform: translateX(4px);
    }
    .proj-nav-next { text-align: right; }
    .proj-nav-dir {
      font-family: var(--font-display);
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .proj-nav-next .proj-nav-dir {
      justify-content: flex-end;
    }
    .proj-nav-title {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--off-white);
      transition: color var(--t);
      line-height: 1.35;
    }
    .proj-nav-card:hover .proj-nav-title {
      color: var(--violet-l);
    }

    /* ═══════════════════════════════════════════════════
       BANNIÈRE CTA DISCUTONS D'UN PROJET
    ═══════════════════════════════════════════════════ */
    .project-cta-box {
      margin-top: 3.5rem;
      background: linear-gradient(135deg, var(--card-bg), #1a1a36);
      border: 1px solid rgba(124,58,237,0.25);
      border-radius: 14px;
      padding: 2.25rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      position: relative;
      overflow: hidden;
    }
    .project-cta-box::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 0%, rgba(124,58,237,0.15), transparent 70%);
      pointer-events: none;
    }
    .project-cta-title {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--off-white);
      letter-spacing: -0.01em;
    }
    .project-cta-text {
      font-size: 0.95rem;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.6;
    }
    .project-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--violet);
      color: #fff;
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 600;
      padding: 0.65rem 1.5rem;
      border-radius: 8px;
      transition: background var(--t), transform var(--t);
    }
    .project-cta-btn:hover {
      background: #6d28d9;
      transform: translateY(-2px);
    }

    /* ═══════════════════════════════════════════════════
       FOOTER IDENTIQUE À LA PAGE PRINCIPALE
    ═══════════════════════════════════════════════════ */
    footer {
      padding: 1.5rem;
      border-top: 1px solid var(--border);
      display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    footer p { font-size: 0.78rem; color: var(--muted); }
    .footer-admin-link {
      color: var(--muted);
      transition: color var(--t);
    }
    .footer-admin-link:hover { color: var(--off-white); }
    @media (min-width: 768px) {
      footer { flex-direction: row; justify-content: space-between; padding: 1.5rem 3rem; text-align: left; }
    }
    @media (min-width: 1100px) { footer { padding: 1.5rem 5rem; } }
  </style>
</head>

<body>
  <!-- Ambiance d'arrière-plan -->
  <div class="bg-noise"></div>
  <div class="bg-glow-1"></div>
  <div class="bg-glow-2"></div>

  <!-- Curseur interactif desktop -->
  <div id="cursor-dot"></div>
  <div id="cursor-ring"></div>

  <!-- ══════════════════════════════════════════
       NAVBAR FLOATING (IDENTIQUE ACCUEIL)
  ══════════════════════════════════════════ -->
  <nav id="navbar">
    <a href={base} class="nav-logo" aria-label="Retour à l'accueil">
      {initials}<span class="dot">.</span>
    </a>
    <div class="nav-links">
      <a href={`${base}#about`}>À propos</a>
      <a href={`${base}#skills`}>Compétences</a>
      <a href={`${base}#projects`}>Projets</a>
      <a href={`${base}#certs`}>Certifications</a>
      <a href={`${base}#contact`}>Contact</a>
      <a href={`${base}#contact`} class="nav-cta">Me contacter</a>
    </div>
    <button class="nav-hamburger" id="hamburger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Menu mobile tiroir -->
  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a href={`${base}#about`} class="drawer-link">À propos</a>
    <a href={`${base}#skills`} class="drawer-link">Compétences</a>
    <a href={`${base}#projects`} class="drawer-link">Projets</a>
    <a href={`${base}#certs`} class="drawer-link">Certifications</a>
    <a href={`${base}#contact`} class="drawer-link">Contact</a>
  </div>

  <!-- ══════════════════════════════════════════
       CORPS PRINCIPAL
  ══════════════════════════════════════════ -->
  <main>

    <!-- Fil d'Ariane & Métadonnées -->
    <div class="breadcrumb-row">
      <a href={`${base}#projects`} class="back-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Tous les projets
      </a>

      <div class="project-meta-badges">
        <span class={`meta-badge ${catInfo.tagClass}`}>
          {catInfo.icon} {catInfo.label}
        </span>
        {statusBadge && (
          <span class={`meta-badge status-badge ${statusBadge.cls}`}>
            <span class={`status-dot ${statusBadge.dotCls}`}></span>
            {statusBadge.text}
          </span>
        )}
        {formattedDate && (
          <time datetime={date ? new Date(date).toISOString() : ''} class="meta-date">
            {formattedDate}
          </time>
        )}
      </div>
    </div>

    <!-- En-tête du projet -->
    <header class="project-hero-header">
      <h1 class="project-main-title">{title}</h1>
      <p class="project-main-desc">{description}</p>

      <!-- Métriques / Chiffres clés -->
      {metrics && metrics.length > 0 && (
        <div class="metrics-grid">
          {metrics.map((m) => (
            <div class="metric-card">
              <div class="metric-value">{m.value}</div>
              <div class="metric-label">{m.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Tags et Liens d'action -->
      <div class="project-actions-row">
        <div class="project-tags">
          {tags.map((tag, idx) => (
            <span class={`tag ${idx % 3 === 1 ? 't' : idx % 3 === 2 ? 'a' : ''}`}>
              {tag}
            </span>
          ))}
        </div>

        {link && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="external-btn">
            <span>Voir le rapport / la démo</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        )}
      </div>

      <!-- 
        ========================================================================
        RECOMMANDATIONS POUR L'ILLUSTRATION PRINCIPALE DU PROJET (EN-TÊTE) :
        - Ratio recommandé : 16:9 ou 21:9 (Bannière ou Mockup d'en-tête)
        - Dimensions idéales : 1400 x 788 px (ou 1920 x 1080 px, min. 1200 x 675 px)
        - Formats recommandés : WebP (optimal), JPG ou PNG
        - Poids max conseillé : < 600 Ko pour préserver un affichage instantané
        - Visuel conseillé : Mockup sur ordinateur portable, capture nette de tableau de bord
        ========================================================================
      -->
      {image && (
        <div class="project-hero-thumb">
          <img
            src={resolveMediaUrl(image)}
            alt={`Illustration pour ${title}`}
          />
        </div>
      )}
    </header>

    <!-- Étude de cas détaillée (Markdown) -->
    <article class="project-prose">
      <slot />
    </article>

    <!-- Bannière d'appel à l'action -->
    <div class="project-cta-box">
      <div class="project-cta-title">Un projet similaire ou une opportunité ?</div>
      <p class="project-cta-text">
        Je suis à l'écoute de nouveaux défis en Business Intelligence, Marketing Digital et stratégie Data.
      </p>
      <a href={`${base}#contact`} class="project-cta-btn">
        <span>Me contacter</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9-9-4 20-7z"/>
        </svg>
      </a>
    </div>

    <!-- Navigation précédent / suivant (Placée tout en bas avant le footer) -->
    {(prevProject || nextProject) && (
      <nav class="project-nav-row" aria-label="Navigation entre projets">
        {prevProject ? (
          <a href={`${base}projects/${prevProject.slug}/`} class="proj-nav-card proj-nav-prev">
            <span class="proj-nav-dir">← Projet précédent</span>
            <span class="proj-nav-title">{prevProject.title}</span>
          </a>
        ) : (
          <div class="proj-nav-spacer" aria-hidden="true"></div>
        )}

        {nextProject ? (
          <a href={`${base}projects/${nextProject.slug}/`} class="proj-nav-card proj-nav-next">
            <span class="proj-nav-dir">Projet suivant →</span>
            <span class="proj-nav-title">{nextProject.title}</span>
          </a>
        ) : (
          <div class="proj-nav-spacer" aria-hidden="true"></div>
        )}
      </nav>
    )}

  </main>

  <!-- ══════════════════════════════════════════
       FOOTER IDENTIQUE À L'ACCUEIL
  ══════════════════════════════════════════ -->
  <footer>
    <p>© {new Date().getFullYear()} {profile.firstName} {profile.lastName} — Tous droits réservés</p>
    <p>{profile.roleBadge}</p>
    <p style="margin-top: 0.75rem;">
      <a href={`${base}admin/`} class="footer-admin-link">⚙️ Administration CMS</a>
    </p>
  </footer>

  <!-- ══════════════════════════════════════════
       SCRIPTS INTERACTIFS
  ══════════════════════════════════════════ -->
  <script>
    // Menu mobile
    const hamburger = document.getElementById('hamburger');
    const drawer    = document.getElementById('nav-drawer');

    function toggleMenu(open: boolean) {
      if (!hamburger || !drawer) return;
      hamburger.classList.toggle('open', open);
      drawer.classList.toggle('open', open);
      drawer.setAttribute('aria-hidden', String(!open));
      hamburger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    }

    hamburger?.addEventListener('click', () => {
      toggleMenu(!hamburger.classList.contains('open'));
    });

    document.querySelectorAll('.drawer-link').forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') toggleMenu(false);
    });

    // Curseur personnalisé (souris physique uniquement)
    if (window.matchMedia('(pointer: fine)').matches) {
      const dot  = document.getElementById('cursor-dot');
      const ring = document.getElementById('cursor-ring');
      let mx = 0, my = 0, rx = 0, ry = 0;

      document.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        if (dot) { dot.style.left = mx + 'px'; dot.style.top = my + 'px'; }
      });

      function animRing() {
        rx += (mx - rx) * 0.12;
        ry += (my - ry) * 0.12;
        if (ring) { ring.style.left = rx + 'px'; ring.style.top = ry + 'px'; }
        requestAnimationFrame(animRing);
      }
      animRing();

      document.querySelectorAll('a, button').forEach(el => {
        el.addEventListener('mouseenter', () => {
          if (!ring) return;
          ring.style.width = '48px'; ring.style.height = '48px';
          ring.style.borderColor = 'var(--teal)'; ring.style.opacity = '0.6';
        });
        el.addEventListener('mouseleave', () => {
          if (!ring) return;
          ring.style.width = '30px'; ring.style.height = '30px';
          ring.style.borderColor = 'var(--violet)'; ring.style.opacity = '0.45';
        });
      });
    }

    // Effet navbar scrolled
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (navbar) {
        navbar.classList.toggle('scrolled', window.scrollY > 40);
      }
    }, { passive: true });
  </script>
</body>
</html>
