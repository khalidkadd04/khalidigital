      triggerEvents.forEach(function(e) { window.removeEventListener(e, triggerGTM); });
    };
    triggerEvents.forEach(function(e) { window.addEventListener(e, triggerGTM, { passive: true, once: true }); });
    setTimeout(initGTM, 4500);
  </script>
