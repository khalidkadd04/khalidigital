---
/**
 * Hero.astro
 * ─────────────────────────────────────────────────────────────────
 * Full-viewport opening section.
 * Design choice: leads with a data callout (KPI stat) rather than
 * just a name — signals the BI/analytics discipline immediately.
 *
 * Props:
 *   name        — full name displayed in the headline
 *   role        — short role descriptor beneath the name
 *   tagline     — one-sentence value proposition
 *   kpiValue    — headline stat (e.g. "4+")
 *   kpiLabel    — what the stat means (e.g. "completed projects")
 *   ctaHref     — primary CTA link target (default: #projects)
 *   cvHref      — CV download path (default: /cv.pdf)
 */

interface Props {
  name?: string;
  role?: string;
  tagline?: string;
  kpiValue?: string;
  kpiLabel?: string;
  ctaHref?: string;
  cvHref?: string;
}

const {
  name     = 'Your Name',
  role     = 'Marketing Digital & Business Intelligence',
  tagline  = 'I translate data into strategy — building dashboards that surface insight and campaigns that convert.',
  kpiValue = '4+',
  kpiLabel = 'completed projects',
  ctaHref  = '#projects',
  cvHref   = '/cv.pdf',
} = Astro.props;
---

<section id="hero" class="hero" aria-label="Introduction">

  <!-- Subtle grid texture -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Ambient glow blobs -->
  <div class="glow glow-indigo" aria-hidden="true"></div>
  <div class="glow glow-teal"   aria-hidden="true"></div>

  <div class="hero-inner">

    <!-- Discipline badge -->
    <div class="hero-badge">
      <span class="avail-dot" aria-hidden="true"></span>
      Open to opportunities · Class of 2025
    </div>

    <!-- Name headline -->
    <h1 class="hero-name">
      <span class="hero-name-first">{name.split(' ')[0]}</span>
      <span class="hero-name-rest">{name.split(' ').slice(1).join(' ')}</span>
    </h1>

    <!-- Role descriptor -->
    <p class="hero-role">{role}</p>

    <!-- Tagline -->
    <p class="hero-tagline">{tagline}</p>

    <!-- Skills chips -->
    <ul class="hero-chips" aria-label="Key disciplines">
      <li class="chip chip-indigo">Business Intelligence</li>
      <li class="chip chip-teal">Digital Marketing</li>
      <li class="chip chip-amber">Data Analytics</li>
      <li class="chip">SEO / SEM</li>
      <li class="chip">Power BI</li>
    </ul>

    <!-- CTA row -->
    <div class="hero-cta">
      <a href={ctaHref} class="btn btn-primary">
        View projects
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href={cvHref} class="btn btn-ghost" download>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download CV
      </a>
    </div>

  </div>

  <!-- KPI callout — the distinctive data-forward element -->
  <aside class="hero-kpi" aria-label="Headline metric">
    <span class="kpi-value" id="kpi-value" data-target={kpiValue}>{kpiValue}</span>
    <span class="kpi-label">{kpiLabel}</span>
    <div class="kpi-divider" aria-hidden="true"></div>
    <span class="kpi-sub">projects · certifications · campaigns</span>
  </aside>

  <!-- Scroll indicator -->
  <div class="scroll-hint" aria-hidden="true">
    <div class="scroll-arrow"></div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: var(--space-24) var(--space-8) var(--space-16);
    overflow: hidden;
    isolation: isolate;
  }

  /* Grid texture */
  .hero-grid {
    position: absolute; inset: 0; z-index: -2;
    background-image:
      linear-gradient(rgba(91,107,248,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91,107,248,0.04) 1px, transparent 1px);
    background-size: 52px 52px;
  }

  /* Ambient glows */
  .glow {
    position: absolute; z-index: -1;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }
  .glow-indigo {
    width: min(560px, 80vw); height: min(560px, 80vw);
    background: radial-gradient(circle, rgba(91,107,248,0.16) 0%, transparent 70%);
    top: -15%; left: -8%;
    animation: float 9s ease-in-out infinite alternate;
  }
  .glow-teal {
    width: min(400px, 60vw); height: min(400px, 60vw);
    background: radial-gradient(circle, rgba(11,206,175,0.10) 0%, transparent 70%);
    bottom: -5%; right: 5%;
    animation: float 11s 2s ease-in-out infinite alternate-reverse;
  }
  @keyframes float {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(18px, 12px) scale(1.04); }
  }

  /* Inner layout */
  .hero-inner {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--sand-dim);
    padding: 5px 12px;
    border: 1px solid var(--ink-border);
    border-radius: 100px;
    width: fit-content;
  }

  /* Name */
  .hero-name {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: var(--sand);
    display: flex;
    flex-direction: column;
  }
  .hero-name-first {
    /* First word in indigo outline treatment */
    color: transparent;
    -webkit-text-stroke: 2px var(--indigo);
  }
  .hero-name-rest {
    color: var(--sand);
  }

  /* Role */
  .hero-role {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--indigo);
    max-width: none;
    text-transform: uppercase;
  }

  /* Tagline */
  .hero-tagline {
    font-size: var(--text-lg);
    color: var(--sand-dim);
    line-height: 1.65;
    max-width: 52ch;
  }

  /* Chips */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: calc(-1 * var(--space-2));
  }
  .chip {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 4px 10px;
    border: 1px solid var(--ink-border);
    border-radius: 100px;
    color: var(--sand-dim);
    background: rgba(255,255,255,0.02);
  }
  .chip-indigo { border-color: rgba(91,107,248,0.3); color: var(--indigo); background: var(--indigo-dim); }
  .chip-teal   { border-color: rgba(11,206,175,0.3); color: var(--teal);   background: var(--teal-dim);   }
  .chip-amber  { border-color: rgba(191,160,122,0.3); color: var(--amber); background: var(--amber-dim);  }

  /* CTA buttons */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius);
    transition: transform var(--t-fast) var(--ease-out),
                box-shadow var(--t) var(--ease-out),
                background var(--t-fast);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary {
    background: var(--indigo);
    color: #fff;
  }
  .btn-primary:hover {
    background: #6e7df9;
    box-shadow: 0 8px 28px rgba(91,107,248,0.35);
  }
  .btn-ghost {
    border: 1px solid var(--ink-border);
    color: var(--sand);
  }
  .btn-ghost:hover {
    border-color: var(--sand-dim);
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  }

  /* KPI callout */
  .hero-kpi {
    position: absolute;
    right: var(--space-12);
    bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    text-align: right;
    display: none; /* shown on large screens */
  }
  .kpi-value {
    font-family: var(--font-display);
    font-size: clamp(5rem, 9vw, 8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--indigo-glow);
  }
  .kpi-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--indigo);
    text-transform: uppercase;
  }
  .kpi-divider {
    width: 40px;
    height: 1px;
    background: var(--indigo-glow);
    margin: var(--space-2) 0 var(--space-2) auto;
  }
  .kpi-sub {
    font-size: var(--text-xs);
    color: var(--sand-dim);
    letter-spacing: 0.04em;
  }

  /* Scroll hint */
  .scroll-hint {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
  }
  .scroll-arrow {
    width: 20px; height: 20px;
    border-right: 1.5px solid var(--sand-dim);
    border-bottom: 1.5px solid var(--sand-dim);
    transform: rotate(45deg);
    animation: bounce 1.8s ease-in-out infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: rotate(45deg) translateY(0); }
    50%       { transform: rotate(45deg) translateY(6px); }
  }

  /* Desktop layout adjustments */
  @media (min-width: 900px) {
    .hero-kpi { display: flex; }
    .scroll-hint { display: none; }
  }
  @media (min-width: 1024px) {
    /* Sidebar takes var(--nav-w), so push content right */
    .hero { padding-left: var(--space-16); }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .hero { padding-top: 6rem; padding-inline: var(--space-6); }
    .hero-name { font-size: clamp(2.2rem, 10vw, 3rem); }
    .hero-tagline { font-size: var(--text-base); }
  }
</style>
