  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{profile.siteTitle}</title>
  <meta name="description" content={profile.siteDescription} />

  <Favicon />

  <!-- Polices locales ultra-rapides (zéro blocage, zéro requête Google Fonts) -->
  <Fonts />

  <style>
    /* ═══════════════════════════════════════════════════
       TOKENS
    ═══════════════════════════════════════════════════ */
    :root {
      --ink:       #0D0D14;
      --ink-2:     #13131F;
      --surface:   #1A1A2E;
      --off-white: #F2F0EC;
      --violet:    #7C3AED;
      --violet-l:  #A78BFA;
      --teal:      #0EA5A0;
      --amber:     #F59E0B;
      --muted:     #7B7C99;
      --border:    rgba(255,255,255,0.07);
      --card-bg:   #16162A;

      --font-display: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-body:    'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --ease:      cubic-bezier(0.4, 0, 0.2, 1);
      --t:         0.35s var(--ease);
    }

    /* ═══════════════════════════════════════════════════
       RESET
    ═══════════════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--ink);
      color: var(--off-white);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* ═══════════════════════════════════════════════════
       CURSEUR — desktop seulement
    ═══════════════════════════════════════════════════ */
    @media (pointer: fine) {
      body { cursor: none; }
      #cursor-dot, #cursor-ring {
        position: fixed; pointer-events: none;
        z-index: 9999; border-radius: 50%;
        transform: translate(-50%, -50%);
      }
      #cursor-dot { width: 5px; height: 5px; background: var(--violet); }
      #cursor-ring {
        width: 30px; height: 30px;
        border: 1.5px solid var(--violet);
        opacity: 0.45;
        transition: width .2s, height .2s, border-color .2s, opacity .2s;
      }
    }

    /* ═══════════════════════════════════════════════════
       NAV
    ═══════════════════════════════════════════════════ */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 200;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.1rem 2rem;
      transition: background var(--t), border-color var(--t), padding var(--t);
      border-bottom: 1px solid transparent;
    }
    nav.scrolled {
      background: rgba(13,13,20,0.88);
      backdrop-filter: blur(20px);
      border-bottom-color: var(--border);
      padding-top: 0.75rem; padding-bottom: 0.75rem;
    }
    .nav-logo {
      font-family: var(--font-display);
      font-weight: 800; font-size: 1.05rem;
      letter-spacing: -0.02em;
      display: flex; align-items: center; gap: 0.3rem;
    }
    .nav-logo .dot { color: var(--violet); font-size: 1.4rem; line-height: 1; }

    /* Desktop links */
    .nav-links {
      display: flex; align-items: center; gap: 2rem;
    }
    .nav-links a {
      font-family: var(--font-display);
      font-size: 0.82rem; font-weight: 500;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--muted);
      transition: color var(--t);
    }
    .nav-links a:hover { color: var(--off-white); }
    .nav-links .nav-cta {
      background: var(--violet);
      color: #fff;
      padding: 0.5rem 1.25rem;
      border-radius: 6px;
      font-weight: 600;
      transition: background var(--t), transform var(--t);
    }
    .nav-links .nav-cta:hover { background: #6d28d9; transform: translateY(-1px); }

    /* Hamburger */
    .nav-hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 44px; height: 44px;
      cursor: pointer;
      background: none; border: none; padding: 8px;
      touch-action: manipulation;
    }
    .nav-hamburger span {
      display: block; width: 22px; height: 2px; border-radius: 2px;
      background: var(--off-white);
      transition: transform .3s, opacity .3s, width .3s;
      transform-origin: left center;
    }
    .nav-hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(2px, -2px); }
    .nav-hamburger.open span:nth-child(2) { opacity: 0; width: 0; }
    .nav-hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(2px, 2px); }

    /* Mobile drawer */
    .nav-drawer {
      display: none;
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(13,13,20,0.97);
      backdrop-filter: blur(24px);
      z-index: 190;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 2rem;
      padding: 2rem 1.5rem;
      overflow-y: auto;
      opacity: 0;
      transition: opacity .3s;
      pointer-events: none;
    }
    .nav-drawer.open {
      opacity: 1;
      pointer-events: all;
    }
    .nav-drawer a {
      font-family: var(--font-display);
      font-size: 1.4rem; font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--muted);
      transition: color .2s;
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.4rem 1rem;
    }
    .nav-drawer a:hover, .nav-drawer a:focus { color: var(--off-white); }

    @media (max-width: 767px) {
      nav { padding: 0.9rem 1.25rem; }
      .nav-links { display: none; }
      .nav-hamburger { display: flex; }
      .nav-drawer { display: flex; }
    }
    @media (min-width: 768px) {
      nav { padding: 1.25rem 3rem; }
    }
    @media (min-width: 1100px) {
      nav { padding: 1.25rem 5rem; }
    }

    /* ═══════════════════════════════════════════════════
       HERO section
    ═══════════════════════════════════════════════════ */
    #hero {
      min-height: 100svh;
      display: flex; align-items: center;
      padding: 6rem 1.5rem 4rem;
      position: relative; overflow: hidden;
    }
    .hero-noise {
      position: absolute; inset: 0; z-index: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      opacity: 0.4;
    }
    .hero-gradient {
      position: absolute; z-index: 0;
      border-radius: 50%;
      filter: blur(80px);
      animation: drift 8s ease-in-out infinite alternate;
    }
    .hero-gradient-1 {
      width: min(500px, 80vw); height: min(500px, 80vw);
      background: radial-gradient(circle, rgba(124,58,237,0.18) 0%, transparent 70%);
      top: -10%; left: -5%;
    }
    .hero-gradient-2 {
      width: min(400px, 60vw); height: min(400px, 60vw);
      background: radial-gradient(circle, rgba(14,165,160,0.12) 0%, transparent 70%);
      bottom: -10%; right: 5%;
      animation-delay: -4s;
    }
    @keyframes drift {
      from { transform: translate(0,0) scale(1); }
      to   { transform: translate(20px, 15px) scale(1.05); }
    }

    /* Badge diplôme */
    .hero-badge {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: rgba(124,58,237,0.12);
      border: 1px solid rgba(124,58,237,0.3);
      border-radius: 100px;
      padding: 0.4rem 1rem;
      font-family: var(--font-display);
      font-size: 0.75rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase;
      color: var(--violet-l);
      margin-bottom: 1.5rem;
      max-width: 100%;
      line-height: 1.35;
      animation: fadeUp 0.4s both;
    }
    .hero-badge .badge-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--teal);
      box-shadow: 0 0 6px var(--teal);
      animation: blink 2s infinite;
      flex-shrink: 0;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; } 50% { opacity: 0.3; }
    }

    .hero-content { position: relative; z-index: 1; max-width: 820px; }

    .hero-name {
      font-family: var(--font-display);
      font-size: clamp(2.1rem, 7.5vw, 6rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin-bottom: 1.25rem;
      word-break: break-word;
    }
    .hero-name .line { display: block; }
    .hero-name .line span {
      display: block;
      animation: slideUp 0.45s cubic-bezier(0.16,1,0.3,1) both;
    }
    .hero-name .line:nth-child(2) span { animation-delay: 0.05s; }
    .hero-name .accent {
      color: transparent;
      -webkit-text-stroke: 2px var(--violet);
    }
    .hero-name .highlight {
      position: relative; display: inline-block;
      color: var(--violet-l);
    }
    .hero-name .highlight::after {
      content: '';
      position: absolute; bottom: 2px; left: 0;
      height: 3px; width: 100%;
      background: linear-gradient(90deg, var(--violet), var(--teal));
      border-radius: 2px;
      transform: scaleX(0);
      transform-origin: left;
      will-change: transform;
      animation: drawLine 0.6s 0.2s cubic-bezier(0.16,1,0.3,1) forwards;
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes drawLine { to { transform: scaleX(1); } }

    .hero-tagline {
      font-size: clamp(0.95rem, 2.5vw, 1.15rem);
      color: var(--muted);
      max-width: 500px;
      line-height: 1.7;
      margin-bottom: 2rem;
      animation: fadeUp 0.45s 0.08s both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hero-pills {
      display: flex; flex-wrap: wrap; gap: 0.45rem;
      margin-bottom: 2rem;
      animation: fadeUp 0.45s 0.12s both;
    }
    .pill {
      font-family: var(--font-display);
      font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.04em;
      padding: 0.3rem 0.8rem;
      border-radius: 100px;
      border: 1px solid var(--border);
      color: var(--muted);
      background: rgba(255,255,255,0.03);
    }
    .pill.v { border-color: rgba(124,58,237,0.4); color: var(--violet-l); background: rgba(124,58,237,0.08); }
    .pill.t { border-color: rgba(14,165,160,0.4); color: var(--teal); background: rgba(14,165,160,0.08); }
    .pill.a { border-color: rgba(245,158,11,0.4); color: var(--amber); background: rgba(245,158,11,0.08); }

    .hero-cta {
      display: flex; flex-wrap: wrap; gap: 0.85rem;
      animation: fadeUp 0.45s 0.16s both;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 0.45rem;
      padding: 0.8rem 1.75rem;
      font-family: var(--font-display);
      font-size: 0.88rem; font-weight: 600;
      border-radius: 8px;
      transition: all var(--t);
      white-space: nowrap;
      min-height: 44px;
      touch-action: manipulation;
    }
    .btn-primary { background: var(--violet); color: #fff; }
    .btn-primary:hover { background: #6d28d9; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(124,58,237,0.35); }
    .btn-ghost { border: 1px solid var(--border); color: var(--off-white); }
    .btn-ghost:hover { border-color: rgba(255,255,255,0.25); transform: translateY(-2px); }

    .hero-scroll-hint {
      position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
      color: var(--muted); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
      animation: fadeUp 0.6s 0.4s both;
      z-index: 1;
    }
    .scroll-arrow {
      width: 18px; height: 18px;
      border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted);
      transform: rotate(45deg);
      animation: arrowBounce 1.6s ease-in-out infinite;
    }
    @keyframes arrowBounce {
      0%,100% { transform: rotate(45deg) translateY(0); }
      50%     { transform: rotate(45deg) translateY(5px); }
    }

    @media (max-width: 480px) {
      #hero { padding: 5.5rem 1.25rem 3.5rem; }
      .hero-cta { flex-direction: column; width: 100%; }
      .hero-cta .btn { width: 100%; justify-content: center; }
      .hero-scroll-hint { display: none; }
      section { padding: 4rem 1.25rem; }
      .section-title { margin-bottom: 2rem; }
    }
    @media (min-width: 768px) {
      #hero { padding: 6rem 3rem 4rem; }
    }
    @media (min-width: 1100px) {
      #hero { padding: 6rem 5rem 4rem; }
    }

    /* ═══════════════════════════════════════════════════
       SECTIONS COMMUNES
    ═══════════════════════════════════════════════════ */
    section { padding: 5rem 1.5rem; }
    @media (min-width: 768px)  { section { padding: 6rem 3rem; } }
    @media (min-width: 1100px) { section { padding: 7rem 5rem; } }

    .section-eyebrow {
      font-family: var(--font-display);
      font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--teal); margin-bottom: 0.75rem;
    }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 800; letter-spacing: -0.025em; line-height: 1.1;
      margin-bottom: 3.5rem;
      word-break: break-word;
    }
    .section-title em { font-style: normal; color: var(--violet-l); }

    /* ═══════════════════════════════════════════════════
       À PROPOS
    ═══════════════════════════════════════════════════ */
    #about {
      background: var(--ink-2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .about-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    @media (min-width: 768px) {
      .about-grid { grid-template-columns: 280px 1fr; gap: 4rem; align-items: start; }
    }
    @media (min-width: 1100px) {
      .about-grid { grid-template-columns: 340px 1fr; gap: 6rem; align-items: center; }
    }

    .about-photo-wrap {
      position: relative;
      max-width: 260px; margin: 0 auto;
    }
    @media (min-width: 768px) { .about-photo-wrap { max-width: none; margin: 0; } }

    .photo-placeholder {
      width: 100%; aspect-ratio: 3/4;
      border-radius: 12px;
      background: var(--surface);
      border: 1px solid var(--border);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 0.75rem;
      color: var(--muted); font-size: 0.8rem;
    }
    .about-photo-wrap::after {
      content: '';
      position: absolute; top: 12px; left: 12px;
      right: -12px; bottom: -12px;
      border: 1px solid rgba(124,58,237,0.35);
      border-radius: 12px; z-index: -1;
    }
    @media (max-width: 480px) {
      .about-photo-wrap { max-width: 220px; }
      .about-photo-wrap::after { top: 8px; left: 8px; right: -8px; bottom: -8px; }
    }

    .about-diploma {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: rgba(14,165,160,0.1);
      border: 1px solid rgba(14,165,160,0.25);
      border-radius: 8px;
      padding: 0.6rem 0.9rem;
      font-size: 0.8rem; font-weight: 500; color: var(--teal);
      margin-bottom: 1.5rem;
      line-height: 1.4;
      max-width: 100%;
    }
    .about-text p {
      color: var(--muted); font-size: 0.97rem; line-height: 1.75;
      margin-bottom: 1.1rem;
    }
    .about-text p strong { color: var(--off-white); font-weight: 500; }

    .about-stats {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 2rem; padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    @media (min-width: 440px) {
      .about-stats {
        grid-template-columns: repeat(3, 1fr);
        gap: 0.85rem;
      }
    }
    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.85rem 1rem;
    }
    @media (min-width: 768px) {
      .stat-card { padding: 1rem 1.25rem; }
    }
    .stat-num {
      font-family: var(--font-display);
      font-size: 1.6rem; font-weight: 800;
      color: var(--violet-l); line-height: 1;
    }
    .stat-label { font-size: 0.75rem; color: var(--muted); margin-top: 0.3rem; }

    /* ═══════════════════════════════════════════════════
       PROJETS
    ═══════════════════════════════════════════════════ */
    .projects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    @media (min-width: 640px)  { .projects-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .projects-grid { grid-template-columns: repeat(3, 1fr); } }

    .project-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px; overflow: hidden;
      transition: transform var(--t), border-color var(--t), box-shadow var(--t);
      display: flex; flex-direction: column;
      height: 100%;
    }
    .project-card:hover {
      transform: translateY(-5px);
      border-color: rgba(124,58,237,0.4);
      box-shadow: 0 16px 50px rgba(0,0,0,0.4);
    }

    .project-thumb {
      aspect-ratio: 16/9;
      background: linear-gradient(135deg, var(--surface), #1e1e3a);
      display: flex; align-items: center; justify-content: center;
      overflow: hidden; position: relative;
      text-decoration: none;
      cursor: pointer;
    }
    .project-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
    .project-card:hover .project-thumb img { transform: scale(1.05); }
    .project-thumb .thumb-icon {
      font-size: 2.5rem; opacity: 0.25;
    }

    .project-status-pill {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      z-index: 2;
      font-family: var(--font-display);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      padding: 0.22rem 0.65rem;
      border-radius: 100px;
      backdrop-filter: blur(12px);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    }
    .project-status-pill.status-done {
      background: rgba(13, 26, 18, 0.88);
      color: #4ade80;
      border: 1px solid rgba(34, 197, 94, 0.35);
    }
    .project-status-pill.status-progress {
      background: rgba(26, 20, 10, 0.88);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.35);
    }
    .project-status-pill.status-test {
      background: rgba(10, 24, 26, 0.88);
      color: var(--teal);
      border: 1px solid rgba(14, 165, 160, 0.35);
    }
    .project-status-pill.status-default {
      background: rgba(20, 16, 32, 0.88);
      color: var(--violet-l);
      border: 1px solid rgba(124, 58, 237, 0.35);
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 6px currentColor;
    }
    .dot-progress {
      animation: pulse-dot 2s infinite ease-in-out;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.8); }
    }

    .project-body { padding: 1.35rem; flex: 1; display: flex; flex-direction: column; }
    .project-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.7rem; }
    .tag {
      font-size: 0.67rem; font-family: var(--font-display); font-weight: 600;
      letter-spacing: 0.04em; padding: 0.22rem 0.6rem;
      border-radius: 100px;
      background: rgba(124,58,237,0.1); color: var(--violet-l);
      border: 1px solid rgba(124,58,237,0.2);
    }
    .tag.t { background: rgba(14,165,160,0.1); color: var(--teal); border-color: rgba(14,165,160,0.2); }
    .tag.a { background: rgba(245,158,11,0.1); color: var(--amber); border-color: rgba(245,158,11,0.2); }

    .project-title {
      font-family: var(--font-display);
      font-size: 1rem; font-weight: 700; margin-bottom: 0.45rem;
      letter-spacing: -0.01em;
    }
    .project-title a { color: inherit; transition: color var(--t); }
    .project-title a:hover { color: var(--violet-l); }
    .project-desc { font-size: 0.84rem; color: var(--muted); line-height: 1.6; margin-bottom: 1.1rem; flex: 1; }
    .project-links { display: flex; gap: 0.75rem; margin-top: auto; flex-wrap: wrap; }
    .project-link {
      font-family: var(--font-display); font-size: 0.8rem; font-weight: 500;
      display: inline-flex; align-items: center; gap: 0.35rem;
      color: var(--muted); transition: color var(--t);
      min-height: 36px;
      padding: 0.2rem 0;
    }
    .project-link:hover { color: var(--off-white); }

    /* ── Bouton Voir tous les projets ── */
    .projects-cta-wrap {
      display: flex;
      justify-content: center;
      margin-top: 3.5rem;
    }
    .btn-all-projects {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.9rem 1.85rem;
      border-radius: 12px;
      background: rgba(124, 58, 237, 0.12);
      border: 1px solid rgba(124, 58, 237, 0.4);
      color: var(--off-white);
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: background var(--t), border-color var(--t), transform var(--t), box-shadow var(--t), color var(--t);
      touch-action: manipulation;
    }
    .btn-all-projects:hover {
      background: var(--violet);
      border-color: var(--violet);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(124, 58, 237, 0.4);
      color: #fff;
    }
    .btn-all-projects svg {
      transition: transform var(--t);
    }
    .btn-all-projects:hover svg {
      transform: translateX(4px);
    }

    /* ═══════════════════════════════════════════════════
       COMPÉTENCES
    ═══════════════════════════════════════════════════ */
    #skills {
      background: var(--ink-2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .skills-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    @media (min-width: 600px)  { .skills-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1100px) { .skills-grid { grid-template-columns: repeat(4, 1fr); } }

    .skill-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px; padding: 1.25rem;
      transition: border-color var(--t), transform var(--t);
    }
    @media (min-width: 768px) {
      .skill-card { padding: 1.5rem; }
    }
    .skill-card:hover { border-color: rgba(124,58,237,0.35); transform: translateY(-3px); }

    .skill-card-icon {
      font-size: 1.6rem; margin-bottom: 1rem;
      width: 44px; height: 44px;
      border-radius: 10px; background: rgba(124,58,237,0.1);
      display: flex; align-items: center; justify-content: center;
    }
    .skill-card-icon.t { background: rgba(14,165,160,0.1); }
    .skill-card-icon.a { background: rgba(245,158,11,0.1); }

    .skill-card-title {
      font-family: var(--font-display);
      font-size: 0.8rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--violet-l); margin-bottom: 1rem;
      padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);
    }
    .skill-card-title.t { color: var(--teal); }
    .skill-card-title.a { color: var(--amber); }

    .skill-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
    .skill-item { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
    .skill-name { font-size: 0.85rem; color: var(--off-white); white-space: normal; word-break: break-word; min-width: 0; }
    .skill-bar-wrap { flex: 1; height: 3px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden; min-width: 40px; }
    .skill-bar { height: 100%; width: 0; border-radius: 2px; transition: width 1.1s cubic-bezier(0.16,1,0.3,1); }
    .skill-bar.v { background: linear-gradient(90deg, var(--violet), var(--violet-l)); }
    .skill-bar.t { background: linear-gradient(90deg, var(--teal), #34d399); }
    .skill-bar.a { background: linear-gradient(90deg, var(--amber), #fcd34d); }

    /* ═══════════════════════════════════════════════════
       CERTIFICATIONS
    ═══════════════════════════════════════════════════ */
    .certs-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    @media (min-width: 600px)  { .certs-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 900px)  { .certs-grid { grid-template-columns: repeat(3, 1fr); } }

    .cert-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px; padding: 1.15rem;
      display: flex; align-items: flex-start; gap: 0.85rem;
      transition: border-color var(--t), transform var(--t);
      flex-wrap: wrap;
    }
    .cert-card:hover { border-color: rgba(14,165,160,0.3); transform: translateY(-3px); }
    .cert-icon {
      flex-shrink: 0; width: 40px; height: 40px; border-radius: 8px;
      background: rgba(14,165,160,0.1);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
    }
    .cert-name {
      font-family: var(--font-display);
      font-size: 0.88rem; font-weight: 700; margin-bottom: 0.2rem;
    }
    .cert-issuer { font-size: 0.75rem; color: var(--muted); }
    .cert-year {
      margin-left: auto; flex-shrink: 0;
      font-family: var(--font-display);
      font-size: 0.7rem; font-weight: 600;
      color: var(--teal);
      background: rgba(14,165,160,0.1);
      padding: 0.15rem 0.5rem; border-radius: 4px;
      white-space: nowrap;
    }

    /* ═══════════════════════════════════════════════════
       CONTACT
    ═══════════════════════════════════════════════════ */
    #contact { text-align: center; }
    .contact-inner { max-width: 760px; margin: 0 auto; }
    .contact-sub {
      color: var(--muted); font-size: 1rem; margin-bottom: 2.5rem; line-height: 1.75;
    }

    /* Layout desktop : email+socials à gauche, form à droite */
    .contact-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: left;
      margin-top: 0;
    }
    @media (max-width: 480px) {
      .contact-layout { gap: 2rem; }
    }
    @media (min-width: 768px) {
      .contact-layout { grid-template-columns: 1fr 1.6fr; gap: 3.5rem; align-items: start; }
    }

    .contact-aside { display: flex; flex-direction: column; gap: 2rem; }

    .contact-aside-label {
      font-family: var(--font-display);
      font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 0.4rem;
    }
    .contact-email {
      display: inline-block;
      font-family: var(--font-display);
      font-size: clamp(0.95rem, 2.5vw, 1.25rem); font-weight: 700;
      padding-bottom: 3px;
      border-bottom: 2px solid var(--violet);
      transition: color var(--t), border-color var(--t);
      word-break: break-word;
      max-width: 100%;
    }
    .contact-email:hover { color: var(--violet-l); border-color: var(--teal); }

    .contact-availability {
      display: flex; align-items: center; gap: 0.5rem;
      font-size: 0.82rem; color: var(--muted);
    }
    .avail-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 6px #22c55e;
      flex-shrink: 0;
      animation: blink 2s infinite;
    }

    .social-links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .social-link {
      display: flex; align-items: center; justify-content: center;
      width: 44px; height: 44px;
      border: 1px solid var(--border); border-radius: 10px;
      color: var(--muted);
      transition: all var(--t);
    }
    .social-link:hover { border-color: var(--violet); color: var(--violet-l); transform: translateY(-3px); }

    /* ── FORMULAIRE ───────────────────────────────────── */
    .gform-wrapper {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem 1.75rem;
    }
    @media (max-width: 480px) {
      .gform-wrapper { padding: 1.5rem 1rem; }
    }
    .gform-title {
      font-family: var(--font-display);
      font-size: 1.05rem; font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
      color: var(--off-white);
    }
    .gform-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    @media (min-width: 480px) {
      .gform-row.two-cols { grid-template-columns: 1fr 1fr; }
    }

    .gform-field { display: flex; flex-direction: column; gap: 0.4rem; }
    .gform-label {
      font-family: var(--font-display);
      font-size: 0.75rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase;
      color: var(--muted);
    }
    .gform-label .required { color: var(--violet-l); margin-left: 2px; }

    .gform-input,
    .gform-textarea,
    .gform-select {
      width: 100%;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-family: var(--font-body);
      font-size: 16px; /* Empêche le zoom auto sur iOS Safari */
      color: var(--off-white);
      outline: none;
      min-height: 44px;
      transition: border-color var(--t), background var(--t), box-shadow var(--t);
      -webkit-appearance: none;
    }
    .gform-input::placeholder,
    .gform-textarea::placeholder { color: var(--muted); opacity: 0.6; }
    .gform-input:focus,
    .gform-textarea:focus,
    .gform-select:focus {
      border-color: var(--violet);
      background: rgba(124,58,237,0.05);
      box-shadow: 0 0 0 3px rgba(124,58,237,0.15);
    }
    .gform-input.error,
    .gform-textarea.error { border-color: #f87171; box-shadow: 0 0 0 3px rgba(248,113,113,0.15); }

    .gform-textarea { resize: vertical; min-height: 120px; line-height: 1.6; }

    .gform-submit {
      width: 100%;
      margin-top: 1.25rem;
      padding: 0.9rem 1.5rem;
      min-height: 48px;
      background: var(--violet);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-family: var(--font-display);
      font-size: 0.92rem; font-weight: 700;
      letter-spacing: 0.02em;
      cursor: pointer;
      touch-action: manipulation;
      transition: background var(--t), transform var(--t), box-shadow var(--t);
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    }
    .gform-submit:hover:not(:disabled) {
      background: #6d28d9;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(124,58,237,0.35);
    }
    .gform-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    /* Spinner */
    .spinner {
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
      display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Messages état */
    .gform-status {
      display: none;
      margin-top: 1rem;
      padding: 0.85rem 1rem;
      border-radius: 8px;
      font-size: 0.85rem; font-weight: 500;
      text-align: center;
    }
    .gform-status.success {
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.25);
      color: #4ade80;
    }
    .gform-status.error-msg {
      background: rgba(248,113,113,0.1);
      border: 1px solid rgba(248,113,113,0.25);
      color: #f87171;
    }
    .gform-error-text {
      font-size: 0.72rem; color: #f87171; margin-top: 0.25rem; display: none;
    }

    /* ═══════════════════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════════════════ */
    footer {
      padding: 1.5rem;
      border-top: 1px solid var(--border);
      display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
      text-align: center;
    }
    footer p { font-size: 0.78rem; color: var(--muted); }
    @media (min-width: 768px) {
      footer { flex-direction: row; justify-content: space-between; padding: 1.5rem 3rem; text-align: left; }
    }
    @media (min-width: 1100px) { footer { padding: 1.5rem 5rem; } }

    /* ═══════════════════════════════════════════════════
       REVEAL ON SCROLL
    ═══════════════════════════════════════════════════ */
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity .65s ease, transform .65s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    .about-avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 20px;
      border: 1px solid var(--border);
    }
    .about-bio {
      margin-top: 1.2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .cert-link {
      color: inherit;
      transition: color var(--t);
    }
    .cert-link:hover {
      color: var(--teal);
    }
    .footer-admin-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--muted);
      opacity: 0.7;
      transition: opacity var(--t), color var(--t);
    }
    .footer-admin-link:hover {
      color: var(--violet-l);
      opacity: 1;
    }

    /* ═══════════════════════════════════════════════════
       REDUCED MOTION
    ═══════════════════════════════════════════════════ */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PG83BFNF"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

  <div id="cursor-dot"></div>
  <div id="cursor-ring"></div>

  <!-- Header unifié partagé -->
  <Header />

  <section id="hero">
    <div class="hero-noise"></div>
    <div class="hero-gradient hero-gradient-1"></div>
    <div class="hero-gradient hero-gradient-2"></div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        {profile.roleBadge}
      </div>

      <h1 class="hero-name">
        <span class="line">
          <span>
            {profile.highlightWord?.toLowerCase() === profile.firstName?.toLowerCase() ? (
              <span class="highlight">{profile.firstName}</span>
            ) : (
              profile.firstName
            )}
          </span>
        </span>
        <span class="line">
          <span>
            {profile.highlightWord?.toLowerCase() === profile.lastName?.toLowerCase() || !profile.highlightWord ? (
              <span class="highlight">{profile.lastName}</span>
            ) : profile.highlightWord ? (
              <><span class="highlight">{profile.highlightWord}</span> {profile.lastName}</>
            ) : (
              profile.lastName
            )}
          </span>
        </span>
      </h1>

      <p class="hero-tagline">
        {profile.tagline}
      </p>

      <div class="hero-pills">
        {profile.heroPills.map((pill) => (
          <span class={`pill ${pill.color === 'violet' ? 'v' : pill.color === 'teal' ? 't' : pill.color === 'amber' ? 'a' : ''}`}>
            {pill.text}
          </span>
        ))}
      </div>

      <div class="hero-cta">
        <a href="#projects" class="btn btn-primary">
          Mes projets
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={resolveMediaUrl(profile.cvFile, base) || '#contact'} class="btn btn-ghost" download={profile.cvFile ? true : undefined}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Télécharger CV
        </a>
      </div>
    </div>

    <div class="hero-scroll-hint">
      <div class="scroll-arrow"></div>
    </div>
  </section>

  <section id="about">
    <div class="section-eyebrow reveal">01 — À propos</div>
    <div class="about-grid">

      <!-- 
        ========================================================================
        RECOMMANDATIONS POUR LA PHOTO DE PROFIL (AVATAR) :
        - Ratio recommandé : 1:1 (Format carré ou portrait centré)
        - Dimensions idéales : 600 x 600 px (minimum 400 x 400 px)
        - Formats acceptés : WebP (optimal pour le web) ou JPG/PNG compressé
        - Poids max conseillé : < 300 Ko pour garantir un temps de chargement ultra-rapide
        - Style conseillé : Arrière-plan épuré ou professionnel, visage bien cadré
        ========================================================================
      -->
      <div class="about-photo-wrap reveal">
        {profile.avatar && profile.avatar.trim() ? (
          <img
            src={resolveMediaUrl(profile.avatar, base)}
            alt={`${profile.firstName} ${profile.lastName}`}
            class="about-avatar-img"
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="photo-placeholder">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            Votre photo
          </div>
        )}
      </div>

      <div class="about-text reveal">
        <div class="section-title" set:html={profile.aboutTitle.replace(/data/i, '<em>$&</em>')} />

        <div class="about-diploma">
          {profile.aboutDiploma}
        </div>

        <div class="about-bio" set:html={profile.aboutBio.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').split('\n\n').map((p) => `<p>${p}</p>`).join('')} />

        <div class="about-stats">
          {profile.stats.map((stat) => (
            <div class="stat-card">
              <div class="stat-num">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="section-eyebrow reveal">02 — Projets</div>
    <div class="section-title reveal">Ce que j'ai <em>réalisé</em></div>

    <div class="projects-grid">
      {projects.map((project) => (
        <article class="project-card reveal">
          <!-- 
            ========================================================================
            RECOMMANDATIONS POUR L'IMAGE DE COUVERTURE DU PROJET (CARTE D'ACCUEIL) :
            - Ratio recommandé : 16:9 (Format paysage standard)
            - Dimensions idéales : 1280 x 720 px (ou 1920 x 1080 px)
            - Formats recommandés : WebP (optimal), JPG ou PNG
            - Poids max conseillé : < 500 Ko pour un chargement fluide
            - Visuel conseillé : Capture nette de dashboard, mockup ou infographie clé
            ========================================================================
          -->
          <a href={`${base}projects/${project.id}/`} class="project-thumb" aria-label={`Voir le projet ${project.data.title}`}>
            {(() => {
              const sb = getStatusBadge(project.data.status);
              return sb ? (
                <span class={`project-status-pill ${sb.cls}`}>
                  <span class={`status-dot ${sb.dotCls}`}></span>
                  {sb.text}
                </span>
              ) : null;
            })()}
            {project.data.image && project.data.image.trim() ? (
              <img
                src={resolveMediaUrl(project.data.image, base)}
                alt={project.data.title}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="thumb-icon">{getCategoryIcon(project.data.category)}</span>
            )}
          </a>
          <div class="project-body">
            <div class="project-tags">
              {project.data.tags.map((tag, i) => (
                <span class={`tag ${i === 0 ? 't' : i === 2 ? 'a' : ''}`.trim()}>{tag}</span>
              ))}
            </div>
            <h3 class="project-title">
              <a href={`${base}projects/${project.id}/`}>{project.data.title}</a>
            </h3>
            <p class="project-desc">
              {project.data.summary || project.data.description}
            </p>
            <div class="project-links">
              <a href={`${base}projects/${project.id}/`} class="project-link">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                {getLinkText(project.data.category)}
              </a>
              {project.data.link && (
                <a href={project.data.link} class="project-link" target="_blank" rel="noopener noreferrer">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                  Lien externe
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Bouton vers la page dédiée de tous les projets -->
    <div class="projects-cta-wrap reveal">
      <a href={`${base}projects/`} class="btn-all-projects">
        <span>Voir tous les projets</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <section id="skills">
    <div class="section-eyebrow reveal">03 — Compétences</div>
    <div class="section-title reveal">Mon <em>toolkit</em></div>

    <div class="skills-grid">
      {skillsData.groups.map((group) => (
        <div class="skill-card reveal">
          <div class={`skill-card-icon ${group.color !== 'v' ? group.color : ''}`}>{group.icon}</div>
          <div class={`skill-card-title ${group.color !== 'v' ? group.color : ''}`}>{group.title}</div>
          <ul class="skill-list">
            {group.skills.map((skill) => (
              <li class="skill-item">
                <span class="skill-name">{skill.name}</span>
                <div class="skill-bar-wrap">
                  <div class={`skill-bar ${group.color}`} data-width={skill.level}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="certs">
    <div class="section-eyebrow reveal">04 — Certifications</div>
    <div class="section-title reveal">Mes <em>accréditations</em></div>

    <div class="certs-grid">
      {certsData.items.map((cert) => (
        <div class="cert-card reveal">
          <div class="cert-icon">{cert.icon || '🎓'}</div>
          <div>
            <div class="cert-name">
              {cert.link ? (
                <a href={cert.link} target="_blank" rel="noopener noreferrer" class="cert-link">
                  {cert.name} ↗
                </a>
              ) : (
                cert.name
              )}
            </div>
            <div class="cert-issuer">{cert.issuer}</div>
          </div>
          <div class="cert-year">{cert.year}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="contact">
    <div class="contact-inner">
      <div class="section-eyebrow reveal">05 — Contact</div>
      <div class="section-title reveal">Travaillons<br/><em>ensemble</em></div>

      <p class="contact-sub reveal">
        Vous avez un projet, une opportunité ou une question ?
        Je suis ouvert aux stages, aux postes juniors et aux missions freelance.
      </p>

      <div class="contact-layout reveal">

        <div class="contact-aside">

          <div>
            <div class="contact-aside-label">Email</div>
            <a href={`mailto:${profile.contact.email}`} class="contact-email">{profile.contact.email}</a>
          </div>

          <div>
            <div class="contact-aside-label">Disponibilité</div>
            <div class="contact-availability">
              <span class="avail-dot"></span>
              {profile.contact.availability}
            </div>
          </div>

          <div>
            <div class="contact-aside-label">Réseaux & Contacts</div>
            <SocialLinks />
          </div>

        </div>

        <div class="gform-wrapper reveal">
          <div class="gform-title">Envoyer un message</div>

          <form id="gform" novalidate>
            <div class="gform-row two-cols">
              <div class="gform-field">
                <label class="gform-label" for="f-nom">
                  Nom complet <span class="required">*</span>
                </label>
                <input
                  id="f-nom" name="entry.397367347" type="text"
                  class="gform-input" placeholder="Jean Dupont"
                  autocomplete="name" required
                />
                <span class="gform-error-text" id="err-nom">Ce champ est requis.</span>
              </div>

              <div class="gform-field">
                <label class="gform-label" for="f-email">
                  Email <span class="required">*</span>
                </label>
                <input
                  id="f-email" name="entry.2131490758" type="email"
                  class="gform-input" placeholder="jean@exemple.com"
                  autocomplete="email" required
                />
                <span class="gform-error-text" id="err-email">Email invalide.</span>
              </div>
            </div>

            <div class="gform-row two-cols">
              <div class="gform-field">
                <label class="gform-label" for="f-tel">Téléphone</label>
                <input
                  id="f-tel" name="entry.251448844" type="tel"
                  class="gform-input" placeholder="+212 6XX XXX XXX"
                  autocomplete="tel"
                />
              </div>

              <div class="gform-field">
                <label class="gform-label" for="f-sujet">
                  Sujet / Objet <span class="required">*</span>
                </label>
                <input
                  id="f-sujet" name="entry.1433315990" type="text"
                  class="gform-input" placeholder="Opportunité de stage…"
                  required
                />
                <span class="gform-error-text" id="err-sujet">Ce champ est requis.</span>
              </div>
            </div>

            <div class="gform-row">
              <div class="gform-field">
                <label class="gform-label" for="f-message">
                  Message <span class="required">*</span>
                </label>
                <textarea
                  id="f-message" name="entry.1477641668"
                  class="gform-textarea" placeholder="Bonjour, je vous contacte à propos de…"
                  required
                ></textarea>
                <span class="gform-error-text" id="err-message">Ce champ est requis.</span>
              </div>
            </div>

            <button type="submit" class="gform-submit" id="gform-btn">
              <span id="btn-text">Envoyer le message</span>
              <div class="spinner" id="btn-spinner"></div>
              <svg id="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9-9-4 20-7z"/></svg>
            </button>

            <div class="gform-status success" id="gform-success">
              ✅ Votre message a bien été envoyé ! Je vous répondrai dans les plus brefs délais.
            </div>
            <div class="gform-status error-msg" id="gform-error">
              ❌ Une erreur est survenue. Veuillez réessayer ou m'écrire directement par email.
            </div>
          </form>
        </div>

      </div></div>
  </section>

  <Footer />

  <script>
    /* ─ Curseur custom (pointer: fine uniquement) ───────────────── */
    if (window.matchMedia('(pointer: fine)').matches) {
      const dot  = document.getElementById('cursor-dot');
      const ring = document.getElementById('cursor-ring');
      let mx = 0, my = 0, rx = 0, ry = 0;

      document.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        if (dot) {
          dot.style.left = mx + 'px';
          dot.style.top = my + 'px';
        }
      });
      (function loop() {
        rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
        if (ring) {
          ring.style.left = rx + 'px';
          ring.style.top = ry + 'px';
        }
        requestAnimationFrame(loop);
      })();

      document.querySelectorAll('a, button').forEach(el => {
        el.addEventListener('mouseenter', () => {
          if (!ring) return;
          ring.style.width = '48px';
          ring.style.height = '48px';
          ring.style.borderColor = 'var(--teal)';
          ring.style.opacity = '0.6';
        });
        el.addEventListener('mouseleave', () => {
          if (!ring) return;
          ring.style.width = '30px';
          ring.style.height = '30px';
          ring.style.borderColor = 'var(--violet)';
          ring.style.opacity = '0.45';
        });
      });
    }

    /* ─ Reveal on scroll ─────────────────────────────────────────── */
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    /* ─ Skill bars ──────────────────────────────────────────────── */
    const barIo = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.querySelectorAll<HTMLElement>('.skill-bar').forEach(b => {
            if (b.dataset.width) b.style.width = b.dataset.width + '%';
          });
          barIo.unobserve(e.target);
        }
      });
    }, { threshold: 0.25 });
    document.querySelectorAll('.skill-card').forEach(el => barIo.observe(el));

    /* ─ Google Form — soumission custom ─────────────────────────── */
    (function () {
      const FORM_ACTION = 'https://docs.google.com/forms/d/e/1FAIpQLSehKkuGqamQNJUWh08raSZae03a0vpGZWZqAgzODG_RPm1v_Q/formResponse';

      const form     = document.getElementById('gform') as HTMLFormElement | null;
      const btn      = document.getElementById('gform-btn') as HTMLButtonElement | null;
      const btnText  = document.getElementById('btn-text');
      const spinner  = document.getElementById('btn-spinner');
      const btnIcon  = document.getElementById('btn-icon');
      const elOk     = document.getElementById('gform-success');
      const elErr    = document.getElementById('gform-error');

      const inputNom     = document.getElementById('f-nom') as HTMLInputElement | null;
      const inputEmail   = document.getElementById('f-email') as HTMLInputElement | null;
      const inputSujet   = document.getElementById('f-sujet') as HTMLInputElement | null;
      const inputMessage = document.getElementById('f-message') as HTMLTextAreaElement | null;

      /* Validation champ par champ */
      function validateField(input: HTMLInputElement | HTMLTextAreaElement | null, errId: string, checkEmail: boolean) {
        if (!input) return false;
        const err = document.getElementById(errId);
        let valid = true;
        if (input.required && !input.value.trim()) {
          valid = false;
        } else if (checkEmail && input.value.trim()) {
          valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim());
        }
        input.classList.toggle('error', !valid);
        if (err) err.style.display = valid ? 'none' : 'block';
        return valid;
      }

      /* Live feedback au blur */
      inputNom?.addEventListener('blur', () => validateField(inputNom, 'err-nom', false));
      inputEmail?.addEventListener('blur', () => validateField(inputEmail, 'err-email', true));
      inputSujet?.addEventListener('blur', () => validateField(inputSujet, 'err-sujet', false));
      inputMessage?.addEventListener('blur', () => validateField(inputMessage, 'err-message', false));

      form?.addEventListener('submit', async function (e) {
        e.preventDefault();

        /* Validation globale avant envoi */
        const v1 = validateField(inputNom, 'err-nom', false);
        const v2 = validateField(inputEmail, 'err-email', true);
        const v3 = validateField(inputSujet, 'err-sujet', false);
        const v4 = validateField(inputMessage, 'err-message', false);
        if (!v1 || !v2 || !v3 || !v4) return;

        /* UI — état chargement */
        if (btn) btn.disabled = true;
        if (btnText) btnText.textContent = 'Envoi en cours…';
        if (spinner) spinner.style.display = 'block';
        if (btnIcon) btnIcon.style.display = 'none';
        if (elOk) elOk.style.display = 'none';
        if (elErr) elErr.style.display = 'none';

        if (!form) return;
        /* Construction des données */
        const body = new FormData(form);

        /* Envoi via fetch — Google retourne CORS error même en succès,
           on considère tout ce qui n'est pas une erreur réseau comme OK */
        try {
          await fetch(FORM_ACTION, {
            method: 'POST',
            mode:   'no-cors',   /* contourne le CORS sans bloquer l'envoi */
            body:   body
          });
          /* no-cors → réponse opaque → on suppose le succès */
          if (elOk) elOk.style.display = 'block';
          form.reset();
          /* Nettoyer les classes erreur */
          form.querySelectorAll('.gform-input, .gform-textarea').forEach(el => el.classList.remove('error'));
        } catch (err) {
          /* Erreur réseau réelle */
          if (elErr) elErr.style.display = 'block';
        } finally {
          if (btn) btn.disabled = false;
          if (btnText) btnText.textContent = 'Envoyer le message';
          if (spinner) spinner.style.display = 'none';
          if (btnIcon) btnIcon.style.display = 'block';
        }
      });
    })();
  </script>

</body>
</html>