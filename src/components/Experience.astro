---
/**
 * Experience.astro
 * ─────────────────────────────────────────────────────────────────
 * Renders two timelines side by side (or stacked on mobile):
 *   • Education
 *   • Experience (internships, freelance, part-time)
 *
 * Plus a Certifications grid below.
 *
 * To edit: modify the arrays below. No external props needed.
 */

const education = [
  {
    degree:      'Bachelor's degree — Marketing Digital & Business Intelligence',
    school:      'Your University / School Name',
    location:    'Casablanca, Morocco',
    period:      '2022 — 2025',
    description: 'Core curriculum: digital marketing strategy, business analytics, data visualisation, consumer behaviour, and project management. Final project: KPI dashboard for an e-commerce client using Power BI.',
    tags:        ['Power BI', 'Google Analytics', 'SQL', 'Marketing Strategy'],
  },
  {
    degree:      'High School Baccalaureate — Economic Sciences',
    school:      'Lycée Mohammed V',
    location:    'Casablanca, Morocco',
    period:      '2019 — 2022',
    description: 'Economics & management stream. Graduated with mention Bien.',
    tags:        [],
  },
];

const experience = [
  {
    title:       'Digital Marketing Intern',
    company:     'Company Name',
    location:    'Casablanca, Morocco',
    period:      'Jun 2024 — Sep 2024',
    type:        'Internship',
    description: 'Managed social media accounts (Instagram & LinkedIn), produced weekly performance reports in Google Data Studio, and assisted with a Google Ads campaign that reduced CPA by 18%.',
    tags:        ['Google Ads', 'Social Media', 'Data Studio', 'Reporting'],
  },
  {
    title:       'Freelance SEO Analyst',
    company:     'Various clients',
    location:    'Remote',
    period:      'Jan 2024 — Present',
    type:        'Freelance',
    description: 'Conducted technical SEO audits and keyword gap analyses for 3 small businesses. Delivered prioritised action plans and tracked progress via Google Search Console.',
    tags:        ['SEO', 'Semrush', 'Search Console', 'Reporting'],
  },
];

const certifications = [
  { name: 'Google Analytics Certification',         issuer: 'Google Skillshop',  year: '2024', color: 'indigo' },
  { name: 'Google Ads — Search',                   issuer: 'Google Skillshop',  year: '2024', color: 'indigo' },
  { name: 'HubSpot Inbound Marketing',             issuer: 'HubSpot Academy',   year: '2024', color: 'teal'   },
  { name: 'Power BI Data Analyst Associate',        issuer: 'Microsoft Learn',   year: '2025', color: 'teal'   },
  { name: 'Meta Social Media Marketing',            issuer: 'Coursera / Meta',   year: '2025', color: 'purple' },
  { name: 'SEMrush SEO Toolkit',                   issuer: 'Semrush Academy',   year: '2024', color: 'amber'  },
];

const colorMap: Record<string, string> = {
  indigo: 'var(--indigo)',
  teal:   'var(--teal)',
  purple: '#A78BFA',
  amber:  'var(--amber)',
};
---

<section id="experience" class="exp-section" aria-labelledby="experience-heading">

  <h2 id="experience-heading" class="section-title">Education & Experience</h2>

  <!-- Two-column timeline -->
  <div class="timelines">

    <!-- Education column -->
    <div class="timeline-col">
      <h3 class="timeline-heading">Education</h3>
      <ol class="timeline" aria-label="Education history">
        {education.map((item, i) => (
          <li class="timeline-item">
            <div class="timeline-marker" aria-hidden="true">
              <div class="marker-dot"></div>
              {i < education.length - 1 && <div class="marker-line"></div>}
            </div>
            <div class="timeline-content">
              <div class="timeline-period">{item.period}</div>
              <h4 class="timeline-title">{item.degree}</h4>
              <div class="timeline-sub">{item.school} · {item.location}</div>
              {item.description && (
                <p class="timeline-desc">{item.description}</p>
              )}
              {item.tags.length > 0 && (
                <ul class="timeline-tags" aria-label="Skills covered">
                  {item.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Experience column -->
    <div class="timeline-col">
      <h3 class="timeline-heading">Experience</h3>
      <ol class="timeline" aria-label="Work experience">
        {experience.map((item, i) => (
          <li class="timeline-item">
            <div class="timeline-marker" aria-hidden="true">
              <div class="marker-dot"></div>
              {i < experience.length - 1 && <div class="marker-line"></div>}
            </div>
            <div class="timeline-content">
              <div class="timeline-period-row">
                <span class="timeline-period">{item.period}</span>
                <span class="exp-type-badge">{item.type}</span>
              </div>
              <h4 class="timeline-title">{item.title}</h4>
              <div class="timeline-sub">{item.company} · {item.location}</div>
              <p class="timeline-desc">{item.description}</p>
              {item.tags.length > 0 && (
                <ul class="timeline-tags" aria-label="Technologies used">
                  {item.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>

  </div><!-- /.timelines -->

  <!-- Certifications -->
  <div class="certs-section">
    <h3 class="certs-heading">Certifications</h3>
    <ul class="certs-grid" aria-label="Professional certifications">
      {certifications.map((cert) => (
        <li class="cert-card">
          <div class="cert-dot" style={`background: ${colorMap[cert.color]}`} aria-hidden="true"></div>
          <div class="cert-body">
            <div class="cert-name">{cert.name}</div>
            <div class="cert-issuer">{cert.issuer}</div>
          </div>
          <span class="cert-year">{cert.year}</span>
        </li>
      ))}
    </ul>
  </div>

</section>

<style>
  .exp-section {
    padding: var(--space-24) var(--space-6);
    border-top: 1px solid var(--ink-border);
  }
  @media (min-width: 1024px) { .exp-section { padding-inline: var(--space-16); } }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--sand);
    margin-bottom: var(--space-12);
  }

  /* Two-column layout */
  .timelines {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }
  @media (min-width: 768px) {
    .timelines { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
  }

  .timeline-heading {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sand-dim);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--ink-border);
  }

  /* Timeline list */
  .timeline { display: flex; flex-direction: column; }
  .timeline-item {
    display: flex;
    gap: var(--space-4);
    position: relative;
  }

  /* Marker column */
  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 16px;
    padding-top: 4px;
  }
  .marker-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--indigo);
    border: 2px solid var(--ink);
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(91,107,248,0.15);
  }
  .marker-line {
    width: 1px;
    flex: 1;
    background: var(--ink-border);
    margin-top: 6px;
    margin-bottom: 6px;
    min-height: 24px;
  }

  /* Content */
  .timeline-content {
    padding-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .timeline-period {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--indigo);
    letter-spacing: 0.04em;
  }
  .timeline-period-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .exp-type-badge {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 100px;
    background: var(--teal-dim);
    color: var(--teal);
  }
  .timeline-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--sand);
    line-height: 1.3;
  }
  .timeline-sub {
    font-size: var(--text-sm);
    color: var(--sand-dim);
  }
  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--sand-dim);
    line-height: 1.65;
    max-width: 50ch;
    margin-top: var(--space-1);
  }
  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }
  .tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--ink-border);
    color: var(--sand-dim);
  }

  /* Certifications */
  .certs-section { border-top: 1px solid var(--ink-border); padding-top: var(--space-12); }
  .certs-heading {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sand-dim);
    margin-bottom: var(--space-6);
  }
  .certs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 640px) { .certs-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) { .certs-grid { grid-template-columns: repeat(3, 1fr); } }

  .cert-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--ink-raised);
    border: 1px solid var(--ink-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    transition: border-color var(--t), transform var(--t);
  }
  .cert-card:hover {
    border-color: rgba(91,107,248,0.25);
    transform: translateY(-2px);
  }
  .cert-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cert-body { flex: 1; min-width: 0; }
  .cert-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--sand);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cert-issuer {
    font-size: var(--text-xs);
    color: var(--sand-dim);
    margin-top: 2px;
  }
  .cert-year {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--sand-dim);
    flex-shrink: 0;
  }
</style>
