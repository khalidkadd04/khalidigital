---
/**
 * ProjectPage.astro
 * ─────────────────────────────────────────────────────────────────
 * Layout harmonisé pour les pages de détail de projet.
 * Respecte à 100% le système de design, les polices, les couleurs,
 * la barre de navigation et le pied de page de la page principale.
 */

import profile from '../content/data/profile.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Favicon from '../components/Favicon.astro';
import { resolveMediaUrl } from '../utils/projects';

interface Metric {
  value: string;
  label: string;
}

interface GalleryItem {
  image: string;
  caption?: string;
}

interface Props {
  title: string;
  description: string;
  tags: string[];
  category: 'bi' | 'marketing' | 'analytics' | 'strategy';
  date: Date;
  status?: string;
  link?: string;
  metrics?: Metric[];
  image?: string;
  gallery?: Array<string | GalleryItem>;
  prevProject?: { slug: string; title: string } | null;
  nextProject?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  tags = [],
  category = 'bi',
  date,
  status,
  link,
  metrics = [],
  image,
  gallery = [],
  prevProject,
  nextProject,
} = Astro.props;

const normalizedGallery: GalleryItem[] = (gallery || []).map((item) => {
  if (typeof item === 'string') {
    return { image: item, caption: '' };
  }
  return item;
}).filter((item) => item && item.image && item.image.trim());

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const initials = `${profile.firstName?.[0] || 'K'}${profile.lastName?.[0] || 'K'}`;

const categoryMeta: Record<string, { label: string; tagClass: string; icon: string }> = {
  bi:        { label: 'Business Intelligence', tagClass: '',  icon: '📊' },
  marketing: { label: 'Marketing Digital',     tagClass: 't', icon: '🎯' },
  analytics: { label: 'Analytics & Data',      tagClass: 'a', icon: '🔍' },
  strategy:  { label: 'Stratégie Digitale',    tagClass: '',  icon: '📱' },
};
const catInfo = categoryMeta[category] ?? { label: category, tagClass: '', icon: '📊' };

const getStatusBadge = (s?: string) => {
  if (!s || !s.trim()) return null;
  const lower = s.toLowerCase().trim();
  if (lower.includes('termin') || lower.includes('fini') || lower.includes('complét')) {
    return { cls: 'status-done', dotCls: 'dot-done', text: s };
  }
  if (lower.includes('cours') || lower.includes('progr') || lower.includes('développ')) {
    return { cls: 'status-progress', dotCls: 'dot-progress', text: s };
  }
  if (lower.includes('test') || lower.includes('révis')) {
    return { cls: 'status-test', dotCls: 'dot-test', text: s };
  }
  return { cls: 'status-default', dotCls: 'dot-default', text: s };
};
const statusBadge = getStatusBadge(status);

const formattedDate = date ? new Date(date).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}) : '';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-PG83BFNF');</script>
  <!-- End Google Tag Manager -->

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — {profile.firstName} {profile.lastName}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} — ${profile.firstName} ${profile.lastName}`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <Favicon />

  <style>
    /* ═══════════════════════════════════════════════════
       TOKENS HARMONISÉS AVEC LA PAGE PRINCIPALE
    ═══════════════════════════════════════════════════ */
    :root {
      --ink:       #0D0D14;
      --ink-2:     #13131F;
      --surface:   #1A1A2E;
      --off-white: #F2F0EC;
      --violet:    #7C3AED;
      --violet-l:  #A78BFA;
      --teal:      #0EA5A0;
      --amber:     #F59E0B;
      --muted:     #7B7C99;
      --border:    rgba(255,255,255,0.07);
      --card-bg:   #16162A;

      --font-display: 'Plus Jakarta Sans', sans-serif;
      --font-body:    'DM Sans', sans-serif;
      --ease:      cubic-bezier(0.4, 0, 0.2, 1);
      --t:         0.35s var(--ease);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--ink);
      color: var(--off-white);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* Curseur interactif desktop */
    @media (pointer: fine) {
      body { cursor: none; }
      #cursor-dot, #cursor-ring {
        position: fixed; pointer-events: none;
        z-index: 9999; border-radius: 50%;
        transform: translate(-50%, -50%);
      }
      #cursor-dot { width: 5px; height: 5px; background: var(--violet); }
      #cursor-ring {
        width: 30px; height: 30px;
        border: 1.5px solid var(--violet);
        opacity: 0.45;
        transition: width .2s, height .2s, border-color .2s, opacity .2s;
      }
    }

    /* ═══════════════════════════════════════════════════
       NAVBAR IDENTIQUE À LA PAGE D'ACCUEIL
    ═══════════════════════════════════════════════════ */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 200;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.1rem 2rem;
      transition: background var(--t), border-color var(--t), padding var(--t);
      border-bottom: 1px solid transparent;
    }
    nav.scrolled {
      background: rgba(13,13,20,0.88);
      backdrop-filter: blur(20px);
      border-bottom-color: var(--border);
      padding-top: 0.75rem; padding-bottom: 0.75rem;
    }
    .nav-logo {
      font-family: var(--font-display);
      font-weight: 800; font-size: 1.05rem;
      letter-spacing: -0.02em;
      display: flex; align-items: center; gap: 0.3rem;
    }
    .nav-logo .dot { color: var(--violet); font-size: 1.4rem; line-height: 1; }

    .nav-links {
      display: flex; align-items: center; gap: 2rem;
    }
    .nav-links a {
      font-family: var(--font-display);
      font-size: 0.82rem; font-weight: 500;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--muted);
      transition: color var(--t);
    }
    .nav-links a:hover { color: var(--off-white); }
    .nav-links .nav-cta {
      background: var(--violet);
      color: #fff;
      padding: 0.5rem 1.25rem;
      border-radius: 6px;
      font-weight: 600;
      transition: background var(--t), transform var(--t);
    }
    .nav-links .nav-cta:hover { background: #6d28d9; transform: translateY(-1px); }

    .nav-hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 44px; height: 44px;
      cursor: pointer;
      background: none; border: none; padding: 8px;
      touch-action: manipulation;
    }
    .nav-hamburger span {
      display: block; width: 22px; height: 2px; border-radius: 2px;
      background: var(--off-white);
      transition: transform .3s, opacity .3s, width .3s;
      transform-origin: left center;
    }
    .nav-hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(2px, -2px); }
    .nav-hamburger.open span:nth-child(2) { opacity: 0; width: 0; }
    .nav-hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(2px, 2px); }

    .nav-drawer {
      display: none;
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(13,13,20,0.97);
      backdrop-filter: blur(24px);
      z-index: 190;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 2rem;
      padding: 2rem 1.5rem;
      overflow-y: auto;
      opacity: 0;
      transition: opacity .3s;
      pointer-events: none;
    }
    .nav-drawer.open {
      opacity: 1;
      pointer-events: all;
    }
    .nav-drawer a {
      font-family: var(--font-display);
      font-size: 1.4rem; font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--muted);
      transition: color .2s;
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.4rem 1rem;
    }
    .nav-drawer a:hover, .nav-drawer a:focus { color: var(--off-white); }

    @media (max-width: 767px) {
      nav { padding: 0.9rem 1.25rem; }
      .nav-links { display: none; }
      .nav-hamburger { display: flex; }
      .nav-drawer { display: flex; }
    }
    @media (min-width: 768px) { nav { padding: 1.25rem 3rem; } }
    @media (min-width: 1100px) { nav { padding: 1.25rem 5rem; } }

    /* ═══════════════════════════════════════════════════
       AMBIANCE D'ARRIÈRE-PLAN
    ═══════════════════════════════════════════════════ */
    .bg-noise {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      opacity: 0.35;
    }
    .bg-glow-1 {
      position: fixed; top: -150px; left: -100px; z-index: 0; pointer-events: none;
      width: 550px; height: 550px; border-radius: 50%;
      background: radial-gradient(circle, rgba(124,58,237,0.14) 0%, transparent 70%);
      filter: blur(80px);
    }
    .bg-glow-2 {
      position: fixed; top: 30%; right: -150px; z-index: 0; pointer-events: none;
      width: 450px; height: 450px; border-radius: 50%;
      background: radial-gradient(circle, rgba(14,165,160,0.10) 0%, transparent 70%);
      filter: blur(80px);
    }

    /* ═══════════════════════════════════════════════════
       CONTENU DU PROJET
    ═══════════════════════════════════════════════════ */
    main {
      flex: 1;
      position: relative;
      z-index: 1;
      padding: 6.5rem 1.5rem 5rem;
      max-width: 860px;
      margin-inline: auto;
      width: 100%;
    }
    @media (max-width: 480px) {
      main { padding: 5.5rem 1.25rem 4rem; }
    }

    /* Fil d'Ariane & Bouton retour */
    .breadcrumb-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2.25rem;
    }
    @media (max-width: 520px) {
      .breadcrumb-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.85rem;
        margin-bottom: 1.75rem;
      }
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--muted);
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      padding: 0.45rem 1rem;
      border-radius: 100px;
      transition: color var(--t), border-color var(--t), background var(--t), transform var(--t);
    }
    .back-btn:hover {
      color: var(--off-white);
      border-color: rgba(124,58,237,0.4);
      background: rgba(124,58,237,0.1);
      transform: translateX(-3px);
    }
    .project-meta-badges {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .meta-badge {
      font-size: 0.72rem;
      font-family: var(--font-display);
      font-weight: 600;
      padding: 0.3rem 0.75rem;
      border-radius: 100px;
      background: rgba(124,58,237,0.12);
      color: var(--violet-l);
      border: 1px solid rgba(124,58,237,0.25);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .meta-badge.t { background: rgba(14,165,160,0.12); color: var(--teal); border-color: rgba(14,165,160,0.25); }
    .meta-badge.a { background: rgba(245,158,11,0.12); color: var(--amber); border-color: rgba(245,158,11,0.25); }
    .meta-badge.status-done {
      background: rgba(34,197,94,0.12);
      color: #4ade80;
      border-color: rgba(34,197,94,0.3);
    }
    .meta-badge.status-progress {
      background: rgba(245,158,11,0.12);
      color: #fbbf24;
      border-color: rgba(245,158,11,0.3);
    }
    .meta-badge.status-test {
      background: rgba(14,165,160,0.12);
      color: var(--teal);
      border-color: rgba(14,165,160,0.3);
    }
    .meta-badge.status-default {
      background: rgba(124,58,237,0.12);
      color: var(--violet-l);
      border-color: rgba(124,58,237,0.3);
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 6px currentColor;
    }
    .dot-progress {
      animation: pulse-dot 2s infinite ease-in-out;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.8); }
    }
    .meta-date {
      font-size: 0.78rem;
      color: var(--muted);
      font-family: var(--font-display);
    }

    /* En-tête du projet */
    .project-hero-header {
      margin-bottom: 2.5rem;
    }
    .project-main-title {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 5vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.15;
      color: var(--off-white);
      margin-bottom: 1rem;
      word-break: break-word;
    }
    .project-main-desc {
      font-size: 1.05rem;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 1.75rem;
    }

    /* Chiffres clés / Métriques */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 0.85rem;
      margin-bottom: 1.75rem;
    }
    .metric-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.15rem;
      transition: border-color var(--t), transform var(--t);
    }
    @media (min-width: 768px) {
      .metric-card { padding: 1.2rem 1.4rem; }
    }
    .metric-card:hover {
      border-color: rgba(124,58,237,0.35);
      transform: translateY(-2px);
    }
    .metric-value {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--violet-l);
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 0.35rem;
    }
    .metric-label {
      font-size: 0.75rem;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    /* Tags et boutons d'action */
    .project-actions-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }
    .project-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .tag {
      font-size: 0.72rem;
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: 0.04em;
      padding: 0.25rem 0.65rem;
      border-radius: 100px;
      background: rgba(124,58,237,0.1);
      color: var(--violet-l);
      border: 1px solid rgba(124,58,237,0.2);
    }
    .tag.t { background: rgba(14,165,160,0.1); color: var(--teal); border-color: rgba(14,165,160,0.2); }
    .tag.a { background: rgba(245,158,11,0.1); color: var(--amber); border-color: rgba(245,158,11,0.2); }

    .external-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--violet);
      color: #fff;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.65rem 1.25rem;
      min-height: 44px;
      border-radius: 8px;
      touch-action: manipulation;
      transition: background var(--t), transform var(--t), box-shadow var(--t);
    }
    .external-btn:hover {
      background: #6d28d9;
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(124,58,237,0.35);
    }
    @media (max-width: 480px) {
      .external-btn {
        width: 100%;
        justify-content: center;
      }
    }

    /* Illustration principale */
    .project-hero-thumb {
      margin-top: 2rem;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--card-bg);
      box-shadow: 0 16px 40px rgba(0,0,0,0.35);
    }
    .project-hero-thumb img {
      width: 100%;
      max-height: 480px;
      object-fit: cover;
    }

    /* ═══════════════════════════════════════════════════
       CORPS DE L'ÉTUDE DE CAS (PROSE MARKDOWN)
    ═══════════════════════════════════════════════════ */
    .project-prose {
      margin-top: 2.75rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--border);
    }
    .project-prose :global(h2) {
      font-family: var(--font-display);
      font-size: 1.55rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--off-white);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .project-prose :global(h2:first-child) { margin-top: 0; }
    .project-prose :global(h3) {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--off-white);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
    .project-prose :global(p) {
      font-size: 1.02rem;
      line-height: 1.8;
      color: rgba(242, 240, 236, 0.88);
      margin-bottom: 1.35rem;
    }
    .project-prose :global(ul), .project-prose :global(ol) {
      padding-left: 1.5rem;
      margin-bottom: 1.5rem;
    }
    .project-prose :global(li) {
      font-size: 1.02rem;
      line-height: 1.75;
      color: rgba(242, 240, 236, 0.88);
      margin-bottom: 0.5rem;
    }
    .project-prose :global(li strong) {
      color: var(--off-white);
    }
    .project-prose :global(code) {
      background: rgba(124,58,237,0.12);
      color: var(--violet-l);
      padding: 0.2rem 0.45rem;
      border-radius: 4px;
      font-size: 0.88em;
      border: 1px solid rgba(124,58,237,0.22);
      font-family: 'JetBrains Mono', monospace, ui-monospace;
    }
    .project-prose :global(table) {
      display: block;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-collapse: collapse;
      margin: 1.5rem 0;
    }
    .project-prose :global(pre) {
      background: #10101c !important;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      overflow-x: auto;
      max-width: 100%;
      -webkit-overflow-scrolling: touch;
      margin: 1.75rem 0;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }
    .project-prose :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 10px;
    }
    .project-prose :global(pre code) {
      background: transparent !important;
      padding: 0;
      border: none;
      color: inherit;
      font-size: 0.9em;
    }
    .project-prose :global(blockquote) {
      border-left: 3px solid var(--violet);
      background: rgba(124,58,237,0.06);
      border-radius: 0 8px 8px 0;
      padding: 1rem 1.4rem;
      margin: 1.75rem 0;
      font-style: italic;
      color: var(--off-white);
    }
    .project-prose :global(a) {
      color: var(--violet-l);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color var(--t);
    }
    .project-prose :global(a:hover) {
      color: var(--teal);
    }

    /* ═══════════════════════════════════════════════════
       NAVIGATION PROJET PRÉCÉDENT / SUIVANT
    ═══════════════════════════════════════════════════ */
    .project-nav-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      position: relative;
      clear: both;
      z-index: 1;
    }
    @media (min-width: 640px) {
      .project-nav-row { grid-template-columns: 1fr 1fr; }
    }
    .proj-nav-spacer {
      display: none;
    }
    @media (min-width: 640px) {
      .proj-nav-spacer {
        display: block;
      }
    }
    .proj-nav-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      transition: border-color var(--t), transform var(--t), box-shadow var(--t);
      position: relative;
    }
    .proj-nav-card:hover {
      border-color: rgba(124,58,237,0.4);
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .proj-nav-prev:hover {
      transform: translateX(-4px);
    }
    .proj-nav-next:hover {
      transform: translateX(4px);
    }
    .proj-nav-next { text-align: right; }
    .proj-nav-dir {
      font-family: var(--font-display);
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .proj-nav-next .proj-nav-dir {
      justify-content: flex-end;
    }
    .proj-nav-title {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--off-white);
      transition: color var(--t);
      line-height: 1.35;
    }
    .proj-nav-card:hover .proj-nav-title {
      color: var(--violet-l);
    }

    /* ═══════════════════════════════════════════════════
       BANNIÈRE CTA DISCUTONS D'UN PROJET
    ═══════════════════════════════════════════════════ */
    .project-cta-box {
      margin-top: 3.5rem;
      background: linear-gradient(135deg, var(--card-bg), #1a1a36);
      border: 1px solid rgba(124,58,237,0.25);
      border-radius: 14px;
      padding: 2.25rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      position: relative;
      overflow: hidden;
    }
    .project-cta-box::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 0%, rgba(124,58,237,0.15), transparent 70%);
      pointer-events: none;
    }
    .project-cta-title {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--off-white);
      letter-spacing: -0.01em;
    }
    .project-cta-text {
      font-size: 0.95rem;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.6;
    }
    .project-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--violet);
      color: #fff;
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 600;
      padding: 0.75rem 1.5rem;
      min-height: 44px;
      border-radius: 8px;
      touch-action: manipulation;
      transition: background var(--t), transform var(--t);
    }
    .project-cta-btn:hover {
      background: #6d28d9;
      transform: translateY(-2px);
    }
    @media (max-width: 480px) {
      .project-cta-box {
        padding: 1.75rem 1.25rem;
      }
      .project-cta-btn {
        width: 100%;
        justify-content: center;
      }
    }

    /* ═══════════════════════════════════════════════════
       FOOTER IDENTIQUE À LA PAGE PRINCIPALE
    ═══════════════════════════════════════════════════ */
    footer {
      padding: 1.5rem;
      border-top: 1px solid var(--border);
      display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    footer p { font-size: 0.78rem; color: var(--muted); }
    .footer-admin-link {
      color: var(--muted);
      transition: color var(--t);
    }
    .footer-admin-link:hover { color: var(--off-white); }
    @media (min-width: 768px) {
      footer { flex-direction: row; justify-content: space-between; padding: 1.5rem 3rem; text-align: left; }
    }
    @media (min-width: 1100px) { footer { padding: 1.5rem 5rem; } }
  </style>
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PG83BFNF"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <!-- Ambiance d'arrière-plan -->
  <div class="bg-noise"></div>
  <div class="bg-glow-1"></div>
  <div class="bg-glow-2"></div>

  <!-- Curseur interactif desktop -->
  <div id="cursor-dot"></div>
  <div id="cursor-ring"></div>

  <!-- Header unifié partagé -->
  <Header />

  <!-- ══════════════════════════════════════════
       CORPS PRINCIPAL
  ══════════════════════════════════════════ -->
  <main>

    <!-- Fil d'Ariane & Métadonnées -->
    <div class="breadcrumb-row">
      <a href={`${base}#projects`} class="back-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Tous les projets
      </a>

      <div class="project-meta-badges">
        <span class={`meta-badge ${catInfo.tagClass}`}>
          {catInfo.icon} {catInfo.label}
        </span>
        {statusBadge && (
          <span class={`meta-badge status-badge ${statusBadge.cls}`}>
            <span class={`status-dot ${statusBadge.dotCls}`}></span>
            {statusBadge.text}
          </span>
        )}
        {formattedDate && (
          <time datetime={date ? new Date(date).toISOString() : ''} class="meta-date">
            {formattedDate}
          </time>
        )}
      </div>
    </div>

    <!-- En-tête du projet -->
    <header class="project-hero-header">
      <h1 class="project-main-title">{title}</h1>
      <p class="project-main-desc">{description}</p>

      <!-- Métriques / Chiffres clés -->
      {metrics && metrics.length > 0 && (
        <div class="metrics-grid">
          {metrics.map((m) => (
            <div class="metric-card">
              <div class="metric-value">{m.value}</div>
              <div class="metric-label">{m.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Tags et Liens d'action -->
      <div class="project-actions-row">
        <div class="project-tags">
          {tags.map((tag, idx) => (
            <span class={`tag ${idx % 3 === 1 ? 't' : idx % 3 === 2 ? 'a' : ''}`}>
              {tag}
            </span>
          ))}
        </div>

        {link && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="external-btn">
            <span>Voir le rapport / la démo</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        )}
      </div>

      <!-- 
        ========================================================================
        RECOMMANDATIONS POUR L'ILLUSTRATION PRINCIPALE DU PROJET (EN-TÊTE) :
        - Ratio recommandé : 16:9 ou 21:9 (Bannière ou Mockup d'en-tête)
        - Dimensions idéales : 1400 x 788 px (ou 1920 x 1080 px, min. 1200 x 675 px)
        - Formats recommandés : WebP (optimal), JPG ou PNG
        - Poids max conseillé : < 600 Ko pour préserver un affichage instantané
        - Visuel conseillé : Mockup sur ordinateur portable, capture nette de tableau de bord
        ========================================================================
      -->
      {image && (
        <div class="project-hero-thumb">
          <img
            src={resolveMediaUrl(image, base)}
            alt={`Illustration pour ${title}`}
          />
        </div>
      )}
    </header>

    <!-- Étude de cas détaillée (Markdown) -->
    <article class="project-prose">
      <slot />
    </article>

    <!-- Galerie d'images supplémentaires (si renseignée dans le projet) -->
    {normalizedGallery && normalizedGallery.length > 0 && (
      <section class="project-gallery-section">
        <div class="gallery-heading">
          <div class="gallery-eyebrow">Illustrations & Captures</div>
          <h2 class="gallery-title">Galerie du <em>projet</em></h2>
          <p class="gallery-subtitle">Cliquez sur une image pour l'agrandir en haute résolution.</p>
        </div>

        <div class="gallery-grid">
          {normalizedGallery.map((item, idx) => (
            <figure class="gallery-item">
              <div
                class="gallery-thumb-wrap"
                role="button"
                tabindex="0"
                data-full-img={resolveMediaUrl(item.image, base)}
                data-caption={item.caption || `${title} — Aperçu ${idx + 1}`}
                aria-label={`Agrandir : ${item.caption || 'Image du projet'}`}
              >
                <img
                  src={resolveMediaUrl(item.image, base)}
                  alt={item.caption || `${title} — Aperçu ${idx + 1}`}
                  loading="lazy"
                />
                <div class="gallery-zoom-badge" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    <line x1="11" y1="8" x2="11" y2="14"/>
                    <line x1="8" y1="11" x2="14" y2="11"/>
                  </svg>
                  <span>Agrandir</span>
                </div>
              </div>
              {item.caption && (
                <figcaption class="gallery-caption">{item.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Bannière d'appel à l'action -->
    <div class="project-cta-box">
      <div class="project-cta-title">Un projet similaire ou une opportunité ?</div>
      <p class="project-cta-text">
        Je suis à l'écoute de nouveaux défis en Business Intelligence, Marketing Digital et stratégie Data.
      </p>
      <a href={`${base}#contact`} class="project-cta-btn">
        <span>Me contacter</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9-9-4 20-7z"/>
        </svg>
      </a>
    </div>

    <!-- Navigation précédent / suivant (Placée tout en bas avant le footer) -->
    {(prevProject || nextProject) && (
      <nav class="project-nav-row" aria-label="Navigation entre projets">
        {prevProject ? (
          <a href={`${base}projects/${prevProject.slug}/`} class="proj-nav-card proj-nav-prev">
            <span class="proj-nav-dir">← Projet précédent</span>
            <span class="proj-nav-title">{prevProject.title}</span>
          </a>
        ) : (
          <div class="proj-nav-spacer" aria-hidden="true"></div>
        )}

        {nextProject ? (
          <a href={`${base}projects/${nextProject.slug}/`} class="proj-nav-card proj-nav-next">
            <span class="proj-nav-dir">Projet suivant →</span>
            <span class="proj-nav-title">{nextProject.title}</span>
          </a>
        ) : (
          <div class="proj-nav-spacer" aria-hidden="true"></div>
        )}
      </nav>
    )}

  </main>

  <!-- Modale Lightbox plein écran -->
  <div id="lightbox-modal" class="lightbox-modal" aria-hidden="true" role="dialog" aria-label="Visualisation de l'image">
    <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
    <div class="lightbox-dialog">
      <button class="lightbox-close" id="lightbox-close" aria-label="Fermer la vue agrandie">✕</button>
      <div class="lightbox-img-box">
        <img id="lightbox-img" src="" alt="" />
      </div>
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
  </div>

  <!-- Pied de page unifié -->
  <Footer />

  <style>
    /* ── Galerie de projet ── */
    .project-gallery-section {
      margin-top: 3.5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--border);
    }
    .gallery-heading {
      margin-bottom: 1.75rem;
    }
    .gallery-eyebrow {
      font-family: var(--font-display);
      font-size: 0.75rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--violet-l); margin-bottom: 0.35rem;
    }
    .gallery-title {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      font-weight: 800; letter-spacing: -0.02em;
      margin-bottom: 0.4rem;
    }
    .gallery-title em { font-style: normal; color: var(--violet-l); }
    .gallery-subtitle {
      color: var(--muted); font-size: 0.92rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    @media (min-width: 640px) {
      .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .gallery-item {
      display: flex; flex-direction: column; gap: 0.6rem;
    }
    .gallery-thumb-wrap {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--card-bg);
      cursor: pointer;
      aspect-ratio: 16/10;
      transition: border-color var(--t), transform var(--t), box-shadow var(--t);
    }
    .gallery-thumb-wrap:hover {
      border-color: rgba(124,58,237,0.45);
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    }
    .gallery-thumb-wrap img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }
    .gallery-thumb-wrap:hover img {
      transform: scale(1.03);
    }

    .gallery-zoom-badge {
      position: absolute; bottom: 12px; right: 12px;
      background: rgba(13, 13, 20, 0.82);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: var(--off-white);
      font-family: var(--font-display);
      font-size: 0.75rem; font-weight: 600;
      padding: 0.35rem 0.75rem; border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.12);
      display: inline-flex; align-items: center; gap: 0.35rem;
      pointer-events: none;
      opacity: 0.9;
      transition: opacity var(--t), transform var(--t);
    }
    .gallery-thumb-wrap:hover .gallery-zoom-badge {
      opacity: 1; transform: scale(1.04);
      border-color: var(--violet); color: var(--violet-l);
    }

    .gallery-caption {
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.4;
      padding: 0 0.25rem;
    }

    /* ── Modale Lightbox ── */
    .lightbox-modal {
      display: none;
      position: fixed; inset: 0;
      z-index: 1000;
      align-items: center; justify-content: center;
      padding: 1.5rem;
    }
    .lightbox-modal.open {
      display: flex;
    }
    .lightbox-backdrop {
      position: absolute; inset: 0;
      background: rgba(13, 13, 20, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .lightbox-dialog {
      position: relative;
      z-index: 1001;
      max-width: 1000px;
      width: 100%;
      display: flex; flex-direction: column; align-items: center;
      animation: zoomIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes zoomIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    .lightbox-close {
      position: absolute; top: -44px; right: 0;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      color: var(--off-white);
      width: 36px; height: 36px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 1.1rem;
      touch-action: manipulation;
      transition: background var(--t), color var(--t);
    }
    .lightbox-close:hover {
      background: var(--violet); color: #fff;
    }
    .lightbox-img-box {
      border-radius: 12px; overflow: hidden;
      border: 1px solid rgba(255,255,255,0.12);
      background: #000;
      box-shadow: 0 24px 60px rgba(0,0,0,0.6);
      max-height: 80vh;
      display: flex; align-items: center; justify-content: center;
    }
    .lightbox-img-box img {
      max-width: 100%; max-height: 80vh;
      object-fit: contain;
    }
    .lightbox-caption {
      margin-top: 0.85rem;
      color: var(--off-white);
      font-size: 0.92rem;
      text-align: center;
      max-width: 700px;
    }
  </style>

  <script>
    // Lightbox pour la galerie d'images
    const lightbox = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxBackdrop = document.getElementById('lightbox-backdrop');

    function openLightbox(src: string, caption: string) {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = src;
      lightboxImg.alt = caption || 'Image agrandie';
      if (lightboxCaption) lightboxCaption.textContent = caption || '';
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lightboxImg) lightboxImg.src = '';
    }

    document.querySelectorAll<HTMLElement>('.gallery-thumb-wrap').forEach((thumb) => {
      const trigger = () => {
        const src = thumb.dataset.fullImg || '';
        const caption = thumb.dataset.caption || '';
        if (src) openLightbox(src, caption);
      };
      thumb.addEventListener('click', trigger);
      thumb.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          trigger();
        }
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxBackdrop?.addEventListener('click', closeLightbox);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('open')) {
        closeLightbox();
      }
    });

    // Curseur personnalisé (souris physique uniquement)
    if (window.matchMedia('(pointer: fine)').matches) {
      const dot  = document.getElementById('cursor-dot');
      const ring = document.getElementById('cursor-ring');
      let mx = 0, my = 0, rx = 0, ry = 0;

      document.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        if (dot) { dot.style.left = mx + 'px'; dot.style.top = my + 'px'; }
      });

      function animRing() {
        rx += (mx - rx) * 0.12;
        ry += (my - ry) * 0.12;
        if (ring) { ring.style.left = rx + 'px'; ring.style.top = ry + 'px'; }
        requestAnimationFrame(animRing);
      }
      animRing();

      document.querySelectorAll('a, button, .gallery-thumb-wrap').forEach(el => {
        el.addEventListener('mouseenter', () => {
          if (!ring) return;
          ring.style.width = '48px'; ring.style.height = '48px';
          ring.style.borderColor = 'var(--teal)'; ring.style.opacity = '0.6';
        });
        el.addEventListener('mouseleave', () => {
          if (!ring) return;
          ring.style.width = '30px'; ring.style.height = '30px';
          ring.style.borderColor = 'var(--violet)'; ring.style.opacity = '0.45';
        });
      });
    }
  </script>
</body>
</html>
