---
/**
 * ProjectPage.astro
 * ─────────────────────────────────────────────────────────────────
 * Layout wrapper for individual project detail pages.
 * Used by src/pages/projects/[slug].astro via <slot />.
 *
 * Renders:
 *   • Back link
 *   • Project header (title, badge, date, tags)
 *   • Metrics strip (if present)
 *   • External link button (if present)
 *   • Prose slot (markdown body rendered by Astro)
 *   • Footer navigation (prev / next project)
 *
 * Props match the content collection schema.
 */

import BaseLayout from './BaseLayout.astro';

interface Metric { value: string; label: string; }

interface Props {
  title:       string;
  description: string;
  tags:        string[];
  category:    'bi' | 'marketing' | 'analytics' | 'strategy';
  date:        Date;
  link?:       string;
  metrics?:    Metric[];
  image?:      string;
  prevProject?: { slug: string; title: string } | null;
  nextProject?: { slug: string; title: string } | null;
}

const {
  title, description, tags, category, date,
  link, metrics, image,
  prevProject, nextProject,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const categoryMeta: Record<string, { label: string; cls: string }> = {
  bi:        { label: 'Business Intelligence', cls: 'badge-bi'        },
  marketing: { label: 'Marketing',             cls: 'badge-marketing' },
  analytics: { label: 'Analytics',             cls: 'badge-analytics' },
  strategy:  { label: 'Strategy',              cls: 'badge-strategy'  },
};
const meta = categoryMeta[category] ?? { label: category, cls: 'badge-bi' };

const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<BaseLayout title={`${title} — Portfolio`} description={description}>

  <div class="project-page">

    <!-- Back link -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}#projects`} class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        All projects
      </a>
    </nav>

    <!-- Project header -->
    <header class="project-header">

      <!-- Category badge + date -->
      <div class="project-meta-row">
        <span class:list={['badge', meta.cls]}>{meta.label}</span>
        <time datetime={date.toISOString()} class="project-date">{formattedDate}</time>
      </div>

      <h1 class="project-title">{title}</h1>
      <p class="project-description">{description}</p>

      <!-- Metrics strip -->
      {metrics && metrics.length > 0 && (
        <ul class="project-metrics" aria-label="Project metrics">
          {metrics.map(({ value, label }) => (
            <li class="proj-metric">
              <span class="proj-metric-value">{value}</span>
              <span class="proj-metric-label">{label}</span>
            </li>
          ))}
        </ul>
      )}

      <!-- Tags + external link -->
      <div class="project-footer-meta">
        <ul class="project-tags" aria-label="Tools and technologies">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        {link && (
          <a href={link} class="project-ext-link" target="_blank" rel="noopener noreferrer">
            View live
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        )}
      </div>

      <!-- Hero image (if present) -->
      {image && (
        <div class="project-image-wrap">
          <img src={image} alt={`Illustration for ${title}`} class="project-image" />
        </div>
      )}

    </header>

    <!-- Markdown prose body -->
    <div class="prose project-prose">
      <slot />
    </div>

    <!-- Prev / Next navigation -->
    <nav class="project-nav" aria-label="Project navigation">
      {prevProject
        ? <a href={`${base}projects/${prevProject.slug}/`} class="proj-nav-link proj-nav-prev">
            <span class="proj-nav-dir">← Previous</span>
            <span class="proj-nav-title">{prevProject.title}</span>
          </a>
        : <span></span>
      }
      {nextProject && (
        <a href={`${base}projects/${nextProject.slug}/`} class="proj-nav-link proj-nav-next">
          <span class="proj-nav-dir">Next →</span>
          <span class="proj-nav-title">{nextProject.title}</span>
        </a>
      )}
    </nav>

  </div>

</BaseLayout>

<style>
  .project-page {
    max-width: 780px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-6) var(--space-24);
  }
  @media (min-width: 1024px) { .project-page { padding-top: var(--space-16); } }

  /* Back link */
  .breadcrumb { margin-bottom: var(--space-8); }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--sand-dim);
    transition: color var(--t-fast), gap var(--t-fast);
  }
  .back-link:hover { color: var(--sand); gap: var(--space-3); }

  /* Header */
  .project-header { margin-bottom: var(--space-12); }
  .project-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .project-date {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--sand-dim);
  }
  .project-title {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: var(--space-4);
    color: var(--sand);
  }
  .project-description {
    font-size: var(--text-lg);
    color: var(--sand-dim);
    line-height: 1.65;
    margin-bottom: var(--space-8);
    max-width: 58ch;
  }

  /* Metrics strip */
  .project-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    background: var(--ink-raised);
    border: 1px solid var(--ink-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .proj-metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .proj-metric-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--indigo);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .proj-metric-label {
    font-size: var(--text-xs);
    color: var(--sand-dim);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* Tags + link row */
  .project-footer-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--ink-border);
    color: var(--sand-dim);
  }
  .project-ext-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--indigo);
    margin-left: auto;
    transition: gap var(--t-fast);
  }
  .project-ext-link:hover { gap: var(--space-2); }

  /* Hero image */
  .project-image-wrap {
    margin-top: var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--ink-border);
  }
  .project-image { width: 100%; }

  /* Prose body */
  .project-prose { margin-top: var(--space-12); }

  /* Prev / next nav */
  .project-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--ink-border);
  }
  .proj-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 40%;
    transition: opacity var(--t-fast);
  }
  .proj-nav-link:hover { opacity: 0.75; }
  .proj-nav-next { text-align: right; margin-left: auto; }
  .proj-nav-dir {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--sand-dim);
    letter-spacing: 0.04em;
  }
  .proj-nav-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--sand);
  }
</style>
